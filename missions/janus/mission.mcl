// Janus — two-faced mission: Claude architects, OpenAI implements.
//
// Spike proving two primitives compose the way we think they do:
//   - `using <profile>` routes different steps to different LLM providers in one mission.
//   - `role: agent` gives only the Implementer step real tool execution (Read/Edit/Write/Bash),
//     and only once the Architect (as judge) has approved the plan that round.
//
// Proposer/Approver negotiate in a loop. Implementer runs only after the separate negotiation
// mission returns an approved plan, so it never participates in the dialogue replay.
//
// Run: forge run missions/janus/mission.mcl --steps

let task = "Implement a token-bucket rate limiter as a standalone Python class: configurable capacity and refill rate, a try_acquire() method, correct behavior under burst and steady-state load, and a short test plan covering the edge cases"

mission Janus(task) = {
    Negotiate(task: task)
    -> Implement(plan: output)
}

mission Negotiate(task) loop(5) = {
    Proposer using implementer
    -> Approver using architect
}

mission Implement(plan) = {
    Implementer using implementer
}

output(Janus)
