<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NOT Native AOT: this is an ASP.NET web host, not the `forge` CLI. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Runner.Contracts\ForgeMission.Runner.Contracts.csproj" />
    <PackageReference Include="Katasec.Forge.Mcl.Serve" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltinMissionReferences\vanilla.oci-ref"
                      LogicalName="ForgeMission.Runner.BuiltinMissionReferences.vanilla.oci-ref" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgeMission.Runner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Katasec.Forge.Mcl.Core" Version="0.1.0" />
    <PackageReference Include="Katasec.Forge.Mcl.MissionRegistry" Version="0.1.0" />
    <PackageReference Include="Katasec.Forge.Mcl.Scout" Version="0.1.0" />
    <PackageReference Include="Katasec.Forge.Mcl.ChatClients" Version="0.1.0" />
    <!-- Raw ADO.NET Postgres for the runner-owned enrichment cache. No EF: cache data stays
         isolated from authbilling_db and the implementation remains trim/AOT-friendly. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
  </ItemGroup>

</Project>
