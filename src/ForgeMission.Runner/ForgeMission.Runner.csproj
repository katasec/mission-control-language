<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NOT Native AOT: this is an ASP.NET web host (like ForgeUI), not the `forge` CLI. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Core\ForgeMission.Core.csproj" />
    <ProjectReference Include="..\ForgeMission.ChatClients\ForgeMission.ChatClients.csproj" />
    <ProjectReference Include="..\ForgeMission.MissionRegistry\ForgeMission.MissionRegistry.csproj" />
    <ProjectReference Include="..\ForgeMission.Scout\ForgeMission.Scout.csproj" />
    <ProjectReference Include="..\ForgeMission.Runner.Contracts\ForgeMission.Runner.Contracts.csproj" />
    <ProjectReference Include="..\ForgeMission.Serve\ForgeMission.Serve.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw ADO.NET Postgres for the runner-owned enrichment cache. No EF: cache data stays
         isolated from authbilling_db and the implementation remains trim/AOT-friendly. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
  </ItemGroup>

</Project>
