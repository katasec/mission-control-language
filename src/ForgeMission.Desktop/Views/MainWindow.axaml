<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ForgeMission.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ForgeMission.Desktop.Views.MainWindow"
        x:Name="RootWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Forge"
        Background="{DynamicResource ForgeBgBrush}"
        Foreground="{DynamicResource ForgeTextBrush}">
    <Window.Styles>
        <Style Selector="Button.forge-outline">
            <Setter Property="Background" Value="{DynamicResource ForgeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ForgeRadiusSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentBrush}" />
            <Setter Property="Padding" Value="{DynamicResource ForgeSpace2}" />
        </Style>
        <Style Selector="Button.forge-outline:pointerover">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.forge-send">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ForgeRadiusSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentContrastBrush}" />
            <Setter Property="Padding" Value="{DynamicResource ForgeSpace3}" />
        </Style>
        <Style Selector="Button.forge-send:pointerover">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.forge-send:disabled">
            <Setter Property="Background" Value="{DynamicResource ForgeSurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextSubtleBrush}" />
        </Style>
        <Style Selector="TextBox.forge-composer">
            <Setter Property="Background" Value="{DynamicResource ForgeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ForgeRadiusSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
            <Setter Property="Padding" Value="{DynamicResource ForgeSpace2}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ForgeRadius}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource ForgeShadow}" />
        </Style>
        <Style Selector="MenuItem.forge-add-folder:pointerover">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentBrush}" />
        </Style>
    </Window.Styles>
    <Grid Margin="{DynamicResource ForgeSpace5}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <Grid>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForgeTextBrush}"
                       Text="Forge" />
        </Grid>

        <TextBlock Grid.Row="1"
                   FontSize="12"
                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                   IsVisible="{Binding IsWorkspaceLabelVisible}"
                   Text="{Binding WorkspaceLabel}" />

        <Border Grid.Row="2"
                Background="{DynamicResource ForgeSurfaceBrush}"
                BorderBrush="{DynamicResource ForgeBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ForgeRadius}"
                Padding="{DynamicResource ForgeSpace3}">
            <Grid>
                <TextBlock Foreground="{DynamicResource ForgeTextMutedBrush}"
                           IsVisible="{Binding IsWorkspaceClosed}"
                           Text="No folder open yet" />
                <ListBox Background="{DynamicResource ForgeSurfaceBrush}" ItemsSource="{Binding Messages}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <StackPanel Margin="0,0,0,12" Spacing="4">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForgeTextBrush}"
                                           Text="{Binding Sender}" />
                                <ItemsControl ItemsSource="{Binding ToolCalls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolCallIndicatorViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ForgeTextMutedBrush}"
                                                           Text="{Binding Glyph}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ForgeTextMutedBrush}"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Foreground="{DynamicResource ForgeTextBrush}"
                                           Text="{Binding Text}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Width="36"
                    Height="36"
                    Classes="forge-outline"
                    Content="+">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Classes="forge-add-folder"
                                  Header="Add folder"
                                  Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding ElementName=RootWindow}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBox Classes="forge-composer"
                     IsEnabled="{Binding IsWorkspaceOpen}"
                     Grid.Column="1"
                     PlaceholderText="{Binding ComposePlaceholder}"
                     Text="{Binding ComposeText}" />
            <Button Grid.Column="2"
                    Classes="forge-send"
                    Command="{Binding SendCommand}"
                    Content="Send" />
        </Grid>
    </Grid>
</Window>
