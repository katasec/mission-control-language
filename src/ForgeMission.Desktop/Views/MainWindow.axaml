<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ForgeMission.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ForgeMission.Desktop.Views.MainWindow"
        x:Name="RootWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Forge">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <Grid>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Forge" />
        </Grid>

        <TextBlock Grid.Row="1"
                   FontSize="12"
                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                   IsVisible="{Binding IsWorkspaceLabelVisible}"
                   Text="{Binding WorkspaceLabel}" />

        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeControlLowBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           IsVisible="{Binding IsWorkspaceClosed}"
                           Text="No folder open yet" />
                <ListBox ItemsSource="{Binding Messages}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <StackPanel Margin="0,0,0,12" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Sender}" />
                                <ItemsControl ItemsSource="{Binding ToolCalls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolCallIndicatorViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                           Text="{Binding Glyph}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Width="36"
                    Height="36"
                    BorderBrush="{DynamicResource ThemeControlLowBrush}"
                    BorderThickness="1"
                    Content="+">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Add folder"
                                  Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding ElementName=RootWindow}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBox IsEnabled="{Binding IsWorkspaceOpen}"
                     Grid.Column="1"
                     PlaceholderText="{Binding ComposePlaceholder}"
                     Text="{Binding ComposeText}" />
            <Button Grid.Column="2" Command="{Binding SendCommand}" Content="Send" />
        </Grid>
    </Grid>
</Window>
