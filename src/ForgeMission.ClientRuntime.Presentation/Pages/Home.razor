@page "/"
@using ForgeMission.ConversationPresentation
@inject IClientRuntimeChannel ClientRuntime
@implements IAsyncDisposable

@if (project is null)
{
    <div class="shell">
        @* The Workbench header band, from the Task 1 reference: wordmark, hairline divider, product
           name. It belongs to the launcher only — once a Project is open the rail owns the
           wordmark and the content region owns its own header (43.20 task 3). *@
        <header class="shell-header">
            <div class="brand">
                <h1>Forge</h1>
                <span class="brand-divider"></span>
                <p class="subtitle">AI Workbench</p>
            </div>
        </header>

        <ProjectLauncher Goal="@goalInput" GoalChanged="value => goalInput = value"
                         Title="@titleInput" TitleChanged="value => titleInput = value"
                         Home="@homeInput" HomeChanged="value => homeInput = value"
                         Busy="busy" Error="@launcherError" Notice="@LauncherNotice"
                         ShowOpenFolder="showOpenFolder" OpenPath="@openPathInput"
                         OpenPathChanged="value => openPathInput = value"
                         GoalCommitted="DraftProjectAsync"
                         Create="CreateProjectAsync"
                         OpenRequested="ToggleOpenFolder"
                         Open="OpenProjectAsync" />
    </div>
}
else
{
    @* The open-Project workbench: a persistent rail and one content region that owns every
       document. The Project's absolute home is deliberately not rendered anywhere — this surface
       exposes no local path (43.20 task 3). *@
    <div class="workbench">
        <WorkbenchRail Selected="view" SelectedChanged="SelectViewAsync" />

        <div class="wb-content">
            <header class="wb-header">
                <h1 class="wb-title">@HeaderTitle</h1>
                <p class="wb-subtitle">@HeaderSubtitle</p>
            </header>

            <main class="wb-document">
                @switch (view)
                {
                    case WorkbenchView.Explorer:
                        <ProjectExplorerView Workbench="workbench" Error="workbenchError"
                                             EntrySelected="OpenDocumentAsync" />
                        break;

                    case WorkbenchView.Document:
                        <ProjectDocumentView Document="document" Error="documentError"
                                             Back="BackToExplorer" />
                        break;

                    case WorkbenchView.Settings:
                        <WorkbenchSettings />
                        break;

                    default:
                        @if (connectionError is not null)
                        {
                            <div class="connection-banner">
                                <span>Connection lost: @connectionError</span>
                                <button class="connection-retry" @onclick="RetryConnectionAsync">Retry</button>
                            </div>
                        }
                        @if (reconnectedWithGap)
                        {
                            <p class="gap-notice">Reconnected. Updates that arrived while disconnected are not shown.</p>
                        }
                        @if (sessionError is not null)
                        {
                            <p class="error-banner">@sessionError</p>
                        }
                        <MissionsView Entries="conversationTranscript.Entries" HasLegacyHistory="hasLegacyHistory" />
                        break;
                }
            </main>

            @* The composer belongs to Missions, so it is absent — not disabled — while another
               document is shown. An action that cannot apply here should not be present. *@
            @if (view == WorkbenchView.Missions)
            {
                <footer class="composer-bar">
                    @* Beside the action that produced it, rather than at the top of a region the
                       person is not looking at. *@
                    @if (missionError is not null)
                    {
                        <p class="composer-error" role="alert">@missionError</p>
                    }
                    <div class="composer">
                        <MissionPicker Missions="missions" Selected="@selectedMission"
                                       Disabled="@(RunBusy || PromptsBlocked)"
                                       SelectedChanged="SelectMissionAsync" />
                        <input class="composer-input" @bind="composerText" @bind:event="oninput" @onkeydown="OnComposerKeyDown"
                               @ref="composerInput"
                               placeholder="@ComposerPlaceholder"
                               disabled="@(RunBusy || PromptsBlocked)" />
                        <button class="composer-run" @onclick="RunMissionAsync" disabled="@(!CanRun)">
                            @RunLabel
                        </button>
                    </div>
                </footer>
            }
        </div>
    </div>
}

<style>
    /* The shell is the launcher's flex column: a fixed header band, then a flexible region that
       owns any scrolling. min-height: 0 is what lets that region actually shrink in a short window
       instead of overflowing the viewport. */
    .shell { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 0; background: var(--bg); font-family: var(--font-sans); color: var(--text); }

    /* The band's height and inset are Workbench theme geometry (--wb-header-*), like every other
       measured value on this surface; nothing here is a literal. */
    .shell-header { flex: none; min-height: var(--wb-header-height); padding: 0 var(--wb-page-inset) 0 var(--wb-header-inset); display: flex; flex-direction: column; justify-content: center; background: var(--surface-sunken); border-bottom: 1px solid var(--border-strong); }
    .brand { display: flex; align-items: baseline; gap: var(--space-5); min-width: 0; }
    .shell-header h1 { margin: 0; font-size: var(--font-size-display); font-weight: 700; color: var(--accent); }
    .brand-divider { align-self: stretch; width: 1px; background: var(--border-strong); }
    .subtitle { margin: 0; font-size: var(--font-size-title); color: var(--text); }

    /* The workbench is ONE grid for the whole viewport: a tokenized rail column and a content
       column that is minmax(0, 1fr) so it can actually shrink. The content region — never the
       page — owns vertical overflow, which is why there is no breakpoint here: the rail contracts
       to its own lower bound and the content takes whatever is left, continuously. */
    .workbench { display: grid; grid-template-columns: var(--wb-rail-width) minmax(0, 1fr); grid-template-areas: "rail content"; height: 100vh; height: 100dvh; min-height: 0; background: var(--bg); font-family: var(--font-sans); color: var(--text); }

    .wb-content { grid-area: content; display: flex; flex-direction: column; min-width: 0; min-height: 0; border-left: 1px solid var(--border-strong); }

    .wb-header { flex: none; min-height: var(--wb-header-height); padding: var(--space-3) var(--wb-page-inset); display: flex; flex-direction: column; justify-content: center; gap: var(--space-1); background: var(--surface-sunken); border-bottom: 1px solid var(--border-strong); min-width: 0; }
    .wb-title { margin: 0; font-size: var(--font-size-title); font-weight: 700; color: var(--text); overflow-wrap: anywhere; }
    .wb-subtitle { margin: 0; font-family: var(--font-mono); font-size: var(--font-size-mono); color: var(--text-muted); overflow-wrap: anywhere; }

    /* min-height: 0 plus overflow-y here is what keeps a long transcript, a long Explorer list, or
       a long document inside the content region instead of scrolling the document body. */
    .wb-document { flex: 1; min-height: 0; min-width: 0; overflow-y: auto; padding: var(--wb-page-inset); display: flex; flex-direction: column; gap: var(--space-5); }

    .connection-banner { align-self: stretch; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); border-radius: var(--radius); padding: var(--space-3); font-size: var(--font-size-body); }
    .connection-retry { flex-shrink: 0; padding: var(--space-1) var(--space-3); border: none; border-radius: var(--radius-pill); background: var(--danger); color: var(--accent-contrast); font-size: var(--font-size-meta); font-weight: 600; cursor: pointer; }
    .gap-notice { align-self: stretch; margin: 0; padding: var(--space-2) var(--space-3); border: 1px dashed var(--border-strong); border-radius: var(--radius); color: var(--text-muted); font-size: var(--font-size-meta); text-align: center; }

    .error-banner { align-self: stretch; background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); border-radius: var(--radius); padding: var(--space-3); font-size: var(--font-size-body); margin: 0; }

    .composer-bar { flex: none; display: flex; flex-direction: column; gap: var(--space-2); border-top: 1px solid var(--border); background: var(--bg); padding: var(--space-4) var(--wb-page-inset) calc(var(--space-4) + var(--safe-bottom)); }
    .composer { display: flex; align-items: center; gap: var(--wb-composer-gap); }
    .composer-input { flex: 1; min-width: 0; height: var(--wb-location-height); border: 1px solid var(--border); border-radius: var(--radius); padding: 0 var(--space-3); font-size: var(--font-size-body); background: var(--surface); color: var(--text); }
    .composer-input:disabled { background: var(--surface-active); color: var(--text-subtle); }

    /* min-width, not width: the busy label ("Starting Janus…") is longer than "Run", and a fixed
       action would clip it at the compact bound instead of growing. */
    .composer-run { flex-shrink: 0; min-width: var(--wb-action-min-width); padding: var(--space-2) var(--space-4); border: none; border-radius: var(--radius-pill); background: var(--accent); color: var(--accent-contrast); font-size: var(--font-size-body); font-weight: 600; white-space: nowrap; cursor: pointer; }
    .composer-run:disabled { background: var(--surface-active); color: var(--text-subtle); cursor: default; }

    .composer-error { margin: 0; padding: var(--space-2) var(--space-3); border: 1px solid var(--danger-border); border-radius: var(--radius); background: var(--danger-bg); color: var(--danger); font-size: var(--font-size-meta); }
</style>

@code {
    // The open Project and its one Client Runtime session. Both are null until a project
    // create/open contract returns — Desktop boot establishes neither.
    private ProjectSummary? project;
    private string? sessionId;

    // Which document the workbench shows. It is presentation state ONLY: nothing in this file
    // recreates a project, session, conversation, or subscription when it changes (43.20 task 3).
    private WorkbenchView view = WorkbenchView.Missions;

    private ProjectWorkbenchProjection? workbench;
    private ProjectOperationError? workbenchError;
    private ProjectDocument? document;
    private ProjectOperationError? documentError;

    // Launcher state. Every value shown here came from the Client Runtime: this page derives no
    // title, slug, or home, and holds no filesystem rule.
    private string goalInput = string.Empty;
    private string titleInput = string.Empty;
    private string homeInput = string.Empty;
    private string openPathInput = string.Empty;
    private bool goalRequired;
    private bool showOpenFolder;
    private bool busy;
    private string? launcherError;

    private string? LauncherNotice => goalRequired
        ? "That folder is not a Forge Project yet. Enter a goal to create one there."
        : null;

    private string composerText = string.Empty;
    private ElementReference composerInput;
    private bool focusComposerAfterRender;

    // One view operation at a time (43.17 task 3). viewCts cancels this view's setup/prompt
    // requests and its event subscription together; viewGeneration is the identity a late result
    // is checked against before it may mutate anything; eventLoopTask is observed, never
    // fire-and-forget. Replacing a folder or mission cancels and awaits the old subscription
    // before creating the replacement, so two subscribers can never overlap.
    //
    // Rail navigation deliberately does NOT begin a view operation: the Project, its session, and
    // its durable subscription outlive every switch.
    private CancellationTokenSource? viewCts;
    private Task? eventLoopTask;
    private int viewGeneration;

    // The mission picker's state, all of it read from the Client Runtime (43.21 task 2). The
    // catalog is NOT declared here: this page holds no list of missions it could fall back to, so
    // it cannot offer one the Runtime would refuse. A null selection is a real state — the
    // Project's manifest names something Forge cannot run — and is never quietly replaced.
    private IReadOnlyList<string> missions = [];
    private string? selectedMission;
    private bool hasLegacyHistory;

    // The one error line this surface shows: a typed selection or run failure, beside the action
    // that produced it.
    private string? missionError;

    // The accepted run being watched, and the mission the Runtime said it started. Both are
    // in-memory only: nothing here browses past runs or restores one on reopen.
    private Guid? activeRunId;
    private string? activeRunMission;
    private bool runInFlight;

    // Durable events observed between pressing Run and its acceptance returning. The tail starts
    // inside the SAME call that starts the run and replays the container from sequence 0, so this
    // run's own first events can arrive before its id does; without this buffer they would be
    // dropped and the first run of a session could render nothing. Cleared on both outcomes, so
    // its lifetime is one request.
    private readonly List<ConversationEvent> pendingEvents = [];

    // The in-flight turn's identity. Retained across a typed or transport failure so a retry of
    // unchanged text sends the identical request; released only on acceptance.
    private Guid? pendingCommandId;
    private string? pendingCommandText;

    private ConversationTranscript conversationTranscript = new();
    private string? sessionError;
    private string? connectionError;
    private bool reconnectedWithGap;

    // A run's activity is built only from relayed durable events, so starting one while the stream
    // is down would add a second unrecoverable gap on top of the one the banner already reports.
    private bool PromptsBlocked => connectionError is not null;

    // Busy from the moment Run is pressed until the run reaches a terminal status — one active run
    // per Project, so a second submission has nowhere to go.
    private bool RunBusy => runInFlight || activeRunId is not null;

    // Named from the durable answer, not from the rendered selection: the two can differ if the
    // selection changed between rendering the button and pressing it.
    private string RunLabel => this switch
    {
        { runInFlight: true } => "Starting…",
        { activeRunMission: { } mission } => $"Starting {mission}…",
        _ => "Run",
    };

    // A disabled composer says why it is disabled rather than looking broken.
    private string ComposerPlaceholder => this switch
    {
        { PromptsBlocked: true } => "Reconnect to run a mission",
        { RunBusy: true } => "Waiting for this run to finish…",
        _ => "What should this mission do?",
    };

    // No selection means no run: the Runtime would refuse it, and an action that cannot succeed
    // should not look available.
    private bool CanRun =>
        selectedMission is not null && !RunBusy && !PromptsBlocked
        && !string.IsNullOrWhiteSpace(composerText);

    // The header names the document you are in and the Project it belongs to — never the Project's
    // location on disk.
    private string HeaderTitle => view switch
    {
        WorkbenchView.Explorer => project?.Title ?? string.Empty,
        WorkbenchView.Document => document?.Title ?? "Project document",
        WorkbenchView.Settings => "Settings",
        _ => "Missions",
    };

    private string HeaderSubtitle => view switch
    {
        WorkbenchView.Explorer => "Project Explorer",
        WorkbenchView.Document => $"{project?.Title} · Project document",
        _ => project?.Title ?? string.Empty,
    };

    // Deliberately no OnInitializedAsync: opening Desktop issues no request, creates no session or
    // event subscription, and gives the Client Runtime no reason to touch the filesystem. The first
    // channel call is the one a person triggers by entering a goal or naming a folder.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusComposerAfterRender)
            return;

        focusComposerAfterRender = false;
        await composerInput.FocusAsync();
    }

    private void ToggleOpenFolder()
    {
        showOpenFolder = !showOpenFolder;
        launcherError = null;
    }

    // Asks the Client Runtime what it would name this Project and where it would put it. The call
    // creates nothing; its answer is shown in editable fields and sent straight back to create.
    private async Task DraftProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(goalInput))
        {
            launcherError = "Enter a goal to start.";
            return;
        }

        var response = await RunLauncherOperationAsync(token =>
            ClientRuntime.SendAsync<ProjectDraftRequest, ProjectDraftResponse>(
                new ProjectDraftRequest(goalInput, NullIfBlank(titleInput), NullIfBlank(homeInput)), token));
        if (response?.Draft is not { } draft)
        {
            launcherError = response?.Error?.Message ?? launcherError;
            return;
        }

        titleInput = draft.ProposedTitle;
        homeInput = draft.HomePath;
    }

    private async Task CreateProjectAsync()
    {
        var response = await RunLauncherOperationAsync(token =>
            ClientRuntime.SendAsync<ProjectCreateRequest, ProjectOperationResponse>(
                new ProjectCreateRequest(goalInput, NullIfBlank(titleInput), NullIfBlank(homeInput)), token));
        if (response is not null)
            await ApplyProjectOutcomeAsync(response);
    }

    private async Task OpenProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(openPathInput))
        {
            launcherError = "Enter a folder to open.";
            return;
        }

        var response = await RunLauncherOperationAsync(token =>
            ClientRuntime.SendAsync<ProjectOpenRequest, ProjectOperationResponse>(
                new ProjectOpenRequest(openPathInput), token));
        if (response is not null)
            await ApplyProjectOutcomeAsync(response);
    }

    // One place decides what a project outcome means for this page. GoalRequired is not a failure:
    // the folder simply has no manifest yet, so the same goal-confirmation fields reopen with the
    // Client Runtime's own proposal already filled in.
    private async Task ApplyProjectOutcomeAsync(ProjectOperationResponse response)
    {
        switch (response.Outcome)
        {
            case ProjectOperationOutcome.Created or ProjectOperationOutcome.Opened when response.Session is not null:
                await EnterProjectAsync(response.Session);
                break;
            case ProjectOperationOutcome.GoalRequired when response.Proposal is not null:
                goalRequired = true;
                showOpenFolder = false;
                titleInput = response.Proposal.ProposedTitle;
                homeInput = response.Proposal.HomePath;
                break;
            default:
                // The row closes on a failure, as the reference frame shows: the message explains
                // what happened, and the typed path is kept so reopening the link restores it.
                showOpenFolder = false;
                launcherError = response.Error?.Message ?? "The Client Runtime returned no Project.";
                break;
        }
    }

    // Opening a Project starts its event loop and reads what the Missions page needs to render.
    // It opens no conversation and creates nothing durable: the Project's Mission container is
    // opened by the first run, not by looking at the page.
    private async Task EnterProjectAsync(ProjectSession opened)
    {
        var operation = await BeginViewAsync();
        project = opened.Project;
        sessionId = opened.SessionId;
        focusComposerAfterRender = true;
        StartEventLoop(operation);

        // Render the workbench BEFORE awaiting the read, so the surface does not sit on the
        // launcher until it completes.
        StateHasChanged();

        await LoadMissionsAsync(operation);
    }

    // Reads the catalog, the persisted selection, and whether this Project retains legacy history.
    // Both payloads can arrive together, and that pairing is the interesting case: a manifest
    // naming a mission Forge cannot run returns the catalog WITH an UnknownMission error, so the
    // picker stays usable and choosing either mission repairs the Project. Nothing invents a
    // selection to fill the gap.
    private async Task LoadMissionsAsync(ViewOperation operation)
    {
        try
        {
            var response = await ClientRuntime.SendAsync<GetProjectMissionsRequest, GetProjectMissionsResponse>(
                new GetProjectMissionsRequest(sessionId!), operation.Token);
            if (!IsCurrent(operation.Generation))
                return;

            if (response.Missions is { } view)
            {
                missions = view.Missions;
                selectedMission = view.Selected;
                hasLegacyHistory = view.HasLegacyHistory;
            }

            missionError = response.Error?.Message;
        }
        catch (OperationCanceledException)
        {
            // Expected: the view was replaced while the read was in flight.
        }
        catch (Exception)
        {
            if (IsCurrent(operation.Generation))
                missionError = RuntimeDidNotAnswer("read this Project's missions");
        }
        finally
        {
            if (IsCurrent(operation.Generation))
                StateHasChanged();
        }
    }

    // Persists the choice at the moment it is made, and renders the value the Client Runtime
    // actually stored. A failure keeps the previous selection on screen: a picker showing a
    // mission the Project did not store would be a lie about what the next run will execute.
    private async Task SelectMissionAsync(string mission)
    {
        if (sessionId is null || viewCts is null)
            return;

        var operation = new ViewOperation(viewGeneration, viewCts.Token);
        missionError = null;
        StateHasChanged();

        try
        {
            var response = await ClientRuntime.SendAsync<SelectProjectMissionRequest, SelectProjectMissionResponse>(
                new SelectProjectMissionRequest(sessionId, mission), operation.Token);
            if (!IsCurrent(operation.Generation))
                return;

            if (response.Error is { } error)
                missionError = error.Message;
            else
                selectedMission = response.SelectedMission;
        }
        catch (OperationCanceledException)
        {
            // Expected: the view was replaced while the selection was in flight.
        }
        catch (Exception)
        {
            if (IsCurrent(operation.Generation))
                missionError = RuntimeDidNotAnswer("save that selection");
        }
        finally
        {
            if (IsCurrent(operation.Generation))
                StateHasChanged();
        }
    }

    /// <summary>
    /// What an UNEXPECTED failure says. Every failure a Project can actually have is already a
    /// typed <see cref="ProjectOperationError"/> with its own sentence; anything reaching here is a
    /// fault, and the exception's own text is not something to put in front of a person.
    ///
    /// It is also actively misleading in the packaged app: with AOT's trimmed resource strings a
    /// plain HTTP failure renders as "net_http_message_not_success_statuscode_reason, 500,
    /// Internal Server Error" — observed in the packaged Desktop, which is exactly where a person
    /// meets it. The cause belongs in the Client Runtime's log, where it is complete; the surface
    /// says what did not happen.
    /// </summary>
    private static string RuntimeDidNotAnswer(string action) =>
        $"Forge could not {action}. The runtime did not answer.";

    // --- workbench navigation (43.20 task 3) ----------------------------------------------------

    // Selecting a rail destination changes the rendered view and, for the Explorer, reads the
    // Project's current projection. It creates nothing: no project operation, no session, no
    // mission call, and no second event subscription — the one started when the Project opened
    // keeps running underneath whichever document is shown, including a live run's.
    private async Task SelectViewAsync(WorkbenchView selected)
    {
        view = selected;
        if (selected == WorkbenchView.Explorer)
            await LoadWorkbenchAsync();
    }

    // Read fresh on every visit rather than cached: the Project's files can change underneath an
    // open workbench, and a stale list would invite opening something that is no longer there.
    private async Task LoadWorkbenchAsync()
    {
        if (sessionId is null || viewCts is null)
            return;

        var operation = new ViewOperation(viewGeneration, viewCts.Token);
        workbenchError = null;

        try
        {
            var response = await ClientRuntime.SendAsync<GetProjectWorkbenchRequest, GetProjectWorkbenchResponse>(
                new GetProjectWorkbenchRequest(sessionId), operation.Token);
            if (!IsCurrent(operation.Generation))
                return;

            workbench = response.Workbench;
            workbenchError = response.Error;
        }
        catch (OperationCanceledException)
        {
            // Expected: the Project was replaced while the read was in flight.
        }
        catch (Exception exception)
        {
            if (IsCurrent(operation.Generation))
                workbenchError = new ProjectOperationError(
                    ProjectOperationErrorCode.InvalidManifest, exception.Message);
        }
        finally
        {
            if (IsCurrent(operation.Generation))
                StateHasChanged();
        }
    }

    // The entry ID goes back exactly as it arrived. This page never interprets it, builds one, or
    // sends anything else — there is no path or reference it could supply instead.
    private async Task OpenDocumentAsync(ProjectExplorerEntry entry)
    {
        if (sessionId is null || viewCts is null)
            return;

        var operation = new ViewOperation(viewGeneration, viewCts.Token);
        view = WorkbenchView.Document;
        document = null;
        documentError = null;
        StateHasChanged();

        try
        {
            var response = await ClientRuntime.SendAsync<OpenProjectDocumentRequest, OpenProjectDocumentResponse>(
                new OpenProjectDocumentRequest(sessionId, entry.EntryId), operation.Token);
            if (!IsCurrent(operation.Generation))
                return;

            document = response.Document;
            documentError = response.Error;
        }
        catch (OperationCanceledException)
        {
            // Expected: the Project was replaced while the open was in flight.
        }
        catch (Exception exception)
        {
            if (IsCurrent(operation.Generation))
                documentError = new ProjectOperationError(
                    ProjectOperationErrorCode.DocumentNotFound, exception.Message);
        }
        finally
        {
            if (IsCurrent(operation.Generation))
                StateHasChanged();
        }
    }

    // Returning re-reads, for the same reason opening does: the Project may have changed while the
    // document was open.
    private async Task BackToExplorer()
    {
        document = null;
        documentError = null;
        await SelectViewAsync(WorkbenchView.Explorer);
    }

    // The launcher's single busy/error boundary. An expected Project failure arrives as a typed
    // response rather than an exception, so only a transport/process fault lands in the catch.
    private async Task<TResponse?> RunLauncherOperationAsync<TResponse>(
        Func<CancellationToken, Task<TResponse>> operation) where TResponse : class
    {
        busy = true;
        launcherError = null;
        StateHasChanged();

        try
        {
            return await operation(CancellationToken.None);
        }
        catch (Exception exception)
        {
            launcherError = exception.Message;
            return null;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private static string? NullIfBlank(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task OnComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanRun)
            await RunMissionAsync();
    }

    // The one invocation path on this surface (43.21 task 2).
    //
    // It sends the session, a command id, and what the person typed. It does NOT send the mission:
    // the Client Runtime reads that from the Project, which is what makes "Presentation never
    // branches execution" structural rather than a rule someone has to follow — there is no
    // argument here through which this page could choose one. The legacy control route is gone,
    // and ClientRuntimePresentationBoundaryTests fails on the mere mention of it.
    private async Task RunMissionAsync()
    {
        if (!CanRun || sessionId is null || viewCts is null)
            return;

        var operation = new ViewOperation(viewGeneration, viewCts.Token);
        var text = composerText;

        // The command id is minted for a SPECIFIC piece of text and survives a failure with it,
        // so pressing Run again reproduces a byte-identical request and the Conversation service
        // returns the original run instead of starting a second one. Editing the text first is a
        // different instruction, so it mints a new id — that rule falls out of this comparison
        // rather than needing separate edit tracking.
        if (pendingCommandId is null || !string.Equals(pendingCommandText, text, StringComparison.Ordinal))
        {
            pendingCommandId = Guid.NewGuid();
            pendingCommandText = text;
        }

        // The composer is NOT cleared here: until the run is accepted, the person's text is the
        // only copy of it that exists anywhere.
        runInFlight = true;
        missionError = null;
        StateHasChanged();

        try
        {
            // Fully qualified: ConversationHost's own internal start request shares this name, and
            // the surface must never be able to reach for that one by accident.
            var response = await ClientRuntime.SendAsync<
                Transport.StartProjectMissionRunRequest, Transport.StartProjectMissionRunResponse>(
                new Transport.StartProjectMissionRunRequest(sessionId, pendingCommandId.Value, text),
                operation.Token);

            if (!IsCurrent(operation.Generation))
                return;

            // The response is an acceptance, not a rendered answer: the run appears as its durable
            // events arrive through the relayed stream.
            if (response.Error is { } error)
            {
                missionError = error.Message;
            }
            else if (response.RunId is { } runId)
            {
                composerText = string.Empty;
                pendingCommandId = null;
                pendingCommandText = null;

                // A new run replaces the previous one's activity rather than appending to it.
                // Nothing accumulates here, and there is no way to browse back.
                activeRunId = runId;
                activeRunMission = response.Mission;
                conversationTranscript = new();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected: the view was replaced while this run was in flight.
        }
        catch (Exception)
        {
            if (IsCurrent(operation.Generation))
                missionError = RuntimeDidNotAnswer("start this run");
        }
        finally
        {
            if (IsCurrent(operation.Generation))
            {
                runInFlight = false;
                // Now that the run's identity is known, the events that arrived while it was not
                // go through the same filter as everything else — kept if they belong to this run,
                // discarded otherwise, including when the start failed and there is no run at all.
                foreach (var buffered in pendingEvents)
                    ApplyConversationEvent(buffered);
                pendingEvents.Clear();

                StateHasChanged();
            }
        }
    }

    // The identity a long operation carries: the generation it belongs to, checked before any
    // state mutation, and the token that cancels it when that view is replaced.
    private readonly record struct ViewOperation(int Generation, CancellationToken Token);

    private bool IsCurrent(int generation) => generation == viewGeneration;

    // Every replacement starts here: the previous subscription is cancelled and awaited before
    // anything new exists, then this view's state is cleared and given a fresh identity. Only a
    // Project create/open reaches this — rail navigation never does.
    private async Task<ViewOperation> BeginViewAsync()
    {
        await StopViewAsync();

        viewGeneration++;
        viewCts = new CancellationTokenSource();

        sessionId = null;
        view = WorkbenchView.Missions;
        workbench = null;
        workbenchError = null;
        document = null;
        documentError = null;
        missions = [];
        selectedMission = null;
        hasLegacyHistory = false;
        missionError = null;
        activeRunId = null;
        activeRunMission = null;
        runInFlight = false;
        pendingEvents.Clear();
        pendingCommandId = null;
        pendingCommandText = null;
        conversationTranscript = new();
        sessionError = null;
        connectionError = null;
        reconnectedWithGap = false;

        return new ViewOperation(viewGeneration, viewCts.Token);
    }

    // ConsumeEventsAsync records its own failures instead of rethrowing, so awaiting the loop here
    // cannot throw and cannot leave a subscription alive past this point.
    private async Task StopViewAsync()
    {
        if (viewCts is null)
            return;

        await viewCts.CancelAsync();
        if (eventLoopTask is not null)
            await eventLoopTask;

        viewCts.Dispose();
        viewCts = null;
        eventLoopTask = null;
    }

    private void StartEventLoop(ViewOperation operation) => eventLoopTask = ConsumeEventsAsync(operation);

    private async Task ConsumeEventsAsync(ViewOperation operation)
    {
        try
        {
            await foreach (var evt in ClientRuntime.Subscribe(operation.Token))
            {
                if (!IsCurrent(operation.Generation))
                    return;

                ApplyEvent(evt);
                await InvokeAsync(StateHasChanged);
            }

            // The stream ended without an error. Nothing further will arrive on it, so this is a
            // disconnection like any other rather than a quietly finished page.
            await ReportDisconnectedAsync(operation, "the Client Runtime event stream ended.");
        }
        catch (OperationCanceledException) when (operation.Token.IsCancellationRequested)
        {
            // Expected: the view was replaced, or the page was disposed.
        }
        catch (Exception exception)
        {
            await ReportDisconnectedAsync(operation, exception.Message);
        }
    }

    private async Task ReportDisconnectedAsync(ViewOperation operation, string reason)
    {
        if (!IsCurrent(operation.Generation))
            return;

        connectionError = reason;
        await InvokeAsync(StateHasChanged);
    }

    // Retry opens a new subscription for the same session, generation, and token. It never
    // recreates the session, resends a prompt, or replays what was missed — no cursor or replay
    // route exists below IClientRuntimeChannel — so the gap notice below is set as the honest
    // record that this transcript is now incomplete. It clears only when a new view begins.
    private async Task RetryConnectionAsync()
    {
        if (viewCts is null || connectionError is null)
            return;

        if (eventLoopTask is not null)
            await eventLoopTask;

        connectionError = null;
        reconnectedWithGap = true;
        StartEventLoop(new ViewOperation(viewGeneration, viewCts.Token));
    }

    private void ApplyEvent(ClientRuntimeEvent evt)
    {
        if (evt.SessionId != sessionId)
            return;

        if (evt.Kind == ClientRuntimeEventKind.ConversationEvent && evt.Conversation is { } conversation)
            ApplyConversationEvent(conversation);
        else if (evt.Kind == ClientRuntimeEventKind.Error)
            missionError = evt.Error;
    }

    // One live run is shown, and only its own events. The Project's container orders every run it
    // has ever had and the tail replays all of them, so without this filter a reopened Project
    // would render its whole history as if it had just happened.
    private void ApplyConversationEvent(ConversationEvent conversation)
    {
        // Between pressing Run and its acceptance the run's identity does not exist yet, so the
        // events cannot be judged. Hold them; the acceptance drains them through this same method.
        if (runInFlight)
        {
            pendingEvents.Add(conversation);
            return;
        }

        if (activeRunId is not { } runId || conversation.RunId != runId)
            return;

        conversationTranscript.Apply(conversation);

        // Terminal: the run is over, so the composer is clean and usable again. Its activity stays
        // on screen — clearing it here would delete the answer at the instant it arrived.
        if (conversation.Kind == ConversationEventKind.RunStatus && IsTerminal(conversation.RunStatus))
        {
            activeRunId = null;
            activeRunMission = null;
            focusComposerAfterRender = true;
        }
    }

    private static bool IsTerminal(ConversationRunStatus? status) => status is
        ConversationRunStatus.Completed or ConversationRunStatus.Rejected
        or ConversationRunStatus.Interrupted or ConversationRunStatus.Failed;

    public async ValueTask DisposeAsync() => await StopViewAsync();
}
