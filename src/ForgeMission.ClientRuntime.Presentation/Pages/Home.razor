@page "/"
@inject IClientRuntimeChannel ClientRuntime
@implements IAsyncDisposable

@if (project is null)
{
    <div class="shell launcher-shell">
        <header class="shell-header"><div class="brand"><h1>Forge</h1><span class="brand-divider"></span><p class="subtitle">AI Workbench</p></div></header>
        <ProjectLauncher Goal="@goalInput" GoalChanged="value => goalInput = value" Title="@titleInput" TitleChanged="value => titleInput = value" Home="@homeInput" HomeChanged="value => homeInput = value" Busy="busy" Error="@launcherError" Notice="@LauncherNotice" ShowOpenFolder="showOpenFolder" OpenPath="@openPathInput" OpenPathChanged="value => openPathInput = value" GoalCommitted="DraftProjectAsync" Create="CreateProjectAsync" OpenRequested="ToggleOpenFolder" Open="OpenProjectAsync" />
    </div>
}
else
{
    <div class="workbench">
        <WorkbenchRail Selected="view" SelectedChanged="ChangeViewAsync" />
        <section class="wb-content">
            <header class="wb-header"><h1>@HeaderTitle</h1><p>@project.Title</p></header>
            @if (connectionError is not null) { <div class="connection-banner"><span>Connection lost: @connectionError</span><button type="button" @onclick="RestartSubscriptionAsync">Retry</button></div> }
            <main class="wb-document">
                @switch (view)
                {
                    case WorkbenchView.Explorer:
                        <ProjectExplorerView Projection="workbench" Runs="runs" Error="workbenchError" EntrySelected="OpenDocumentAsync" TraceRequested="OpenTraceAsync" />
                        break;
                    case WorkbenchView.Document:
                        <ProjectDocumentView Document="document" Error="documentError" Back="BackToExplorer" />
                        break;
                    case WorkbenchView.Settings:
                        <WorkbenchSettings />
                        break;
                    case WorkbenchView.RunTrace:
                        <RunTraceView Run="selectedRun" Events="traceEvents" AfterSequence="traceAfter" ThroughSequence="traceThrough" Error="traceError" Back="BackToMissions" Earlier="EarlierTraceAsync" Later="LaterTraceAsync" Latest="LatestTraceAsync" />
                        break;
                    default:
                        <MissionsView Page="runs" Loading="loadingState" OlderPage="@(runCursor is not null)" HistoryError="historyError" HasLegacyHistory="@(missionState?.Missions.HasLegacyHistory ?? false)" TraceRequested="OpenTraceAsync" InstructionRequested="ShowInstructionAsync" Refresh="LatestRunsAsync" Older="OlderRunsAsync" Latest="LatestRunsAsync" />
                        @if (expandedInstruction is not null) { <section class="instruction-detail"><button type="button" @onclick="HideInstruction">Hide instruction</button><pre>@expandedInstruction</pre></section> }
                        @if (newRunsAvailable) { <button type="button" class="new-runs" @onclick="LatestRunsAsync">New runs available</button> }
                        break;
                }
            </main>
            @if (view == WorkbenchView.Missions && missionState is { } state)
            {
                <footer class="composer-bar"><MissionComposer Missions="state.Missions" Submission="state.Submission" Error="submissionError" HistoryAvailable="@HistoryAvailable" ActiveRun="@HasActiveRun" Busy="submissionBusy" MissionSelected="SelectMissionAsync" Run="StartRunAsync" Retry="RetrySubmissionAsync" /></footer>
            }
        </section>
    </div>
}

@code {
    private ProjectSummary? project;
    private string? sessionId;
    private WorkbenchView view = WorkbenchView.Missions;
    private ProjectMissionState? missionState;
    private ProjectRunPage? runs;
    private ProjectRunCursor? runCursor;
    private ProjectOperationError? historyError;
    private ProjectOperationError? submissionError;
    private bool loadingState;
    private bool submissionBusy;
    private bool newRunsAvailable;
    private ProjectWorkbenchProjection? workbench;
    private ProjectOperationError? workbenchError;
    private ProjectDocument? document;
    private ProjectOperationError? documentError;
    private ProjectRunDetail? selectedRun;
    private ProjectRunEventPage? traceEvents;
    private ProjectOperationError? traceError;
    private long traceAfter;
    private long traceThrough;
    private string? expandedInstruction;

    private string goalInput = string.Empty;
    private string titleInput = string.Empty;
    private string homeInput = string.Empty;
    private string openPathInput = string.Empty;
    private bool goalRequired;
    private bool showOpenFolder;
    private bool busy;
    private string? launcherError;
    private string? LauncherNotice => goalRequired ? "That folder is not a Forge Project yet. Enter a goal to create one there." : null;

    private CancellationTokenSource? lifetime;
    private Task? subscription;
    private int generation;
    private string? connectionError;

    private bool HistoryAvailable => missionState?.Runs is not null && historyError is null && !missionState.Runs.Synchronizing;
    private bool HasActiveRun => runs?.Runs.Any(run => !Terminal(run.Status)) == true;
    private string HeaderTitle => view switch { WorkbenchView.Explorer or WorkbenchView.Document => "Project Explorer", WorkbenchView.Settings => "Settings", WorkbenchView.RunTrace => "Run trace", _ => "Missions" };

    private void ToggleOpenFolder() { showOpenFolder = !showOpenFolder; launcherError = null; }
    private async Task DraftProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(goalInput)) { launcherError = "Enter a goal to start."; return; }
        var response = await LauncherAsync(token => ClientRuntime.SendAsync<ProjectDraftRequest, ProjectDraftResponse>(new(goalInput, Blank(titleInput), Blank(homeInput)), token));
        if (response?.Draft is { } draft) { titleInput = draft.ProposedTitle; homeInput = draft.HomePath; }
        else if (response?.Error is { } error) launcherError = error.Message;
    }
    private async Task CreateProjectAsync()
    {
        var response = await LauncherAsync(token => ClientRuntime.SendAsync<ProjectCreateRequest, ProjectOperationResponse>(new(goalInput, Blank(titleInput), Blank(homeInput)), token));
        if (response is not null) await ApplyProjectAsync(response);
    }
    private async Task OpenProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(openPathInput)) { launcherError = "Enter a folder to open."; return; }
        var response = await LauncherAsync(token => ClientRuntime.SendAsync<ProjectOpenRequest, ProjectOperationResponse>(new(openPathInput), token));
        if (response is not null) await ApplyProjectAsync(response);
    }
    private async Task<T?> LauncherAsync<T>(Func<CancellationToken, Task<T>> operation) where T : class
    {
        busy = true; launcherError = null;
        try { return await operation(CancellationToken.None); }
        catch (Exception exception) { launcherError = exception.Message; return null; }
        finally { busy = false; }
    }
    private async Task ApplyProjectAsync(ProjectOperationResponse response)
    {
        if (response.Outcome is ProjectOperationOutcome.Created or ProjectOperationOutcome.Opened && response.Session is { } opened) { await EnterProjectAsync(opened); return; }
        if (response.Outcome == ProjectOperationOutcome.GoalRequired && response.Proposal is { } proposal) { goalRequired = true; showOpenFolder = false; titleInput = proposal.ProposedTitle; homeInput = proposal.HomePath; return; }
        showOpenFolder = false; launcherError = response.Error?.Message ?? "The Client Runtime returned no Project.";
    }
    private async Task EnterProjectAsync(ProjectSession opened)
    {
        await StopLifetimeAsync();
        generation++;
        project = opened.Project; sessionId = opened.SessionId; view = WorkbenchView.Missions;
        lifetime = new CancellationTokenSource();
        subscription = ConsumeEventsAsync(generation, lifetime.Token);
        await RefreshStateAsync(forceLatest: true);
    }
    private async Task ChangeViewAsync(WorkbenchView next)
    {
        view = next; expandedInstruction = null;
        if (next == WorkbenchView.Explorer) await LoadWorkbenchAsync();
    }
    private async Task RefreshStateAsync(bool forceLatest = false)
    {
        if (sessionId is null || lifetime is null) return;
        loadingState = true;
        try
        {
            var response = await ClientRuntime.SendAsync<GetProjectMissionStateRequest, GetProjectMissionStateResponse>(new(sessionId), lifetime.Token);
            if (response.Error is { } error) { historyError = error; return; }
            if (response.State is not { } state) return;
            missionState = state;
            historyError = state.HistoryError;
            if (state.Runs is { } page && (forceLatest || runCursor is null)) { runs = page; runCursor = null; newRunsAvailable = false; }
            else if (state.Runs is not null) newRunsAvailable = true;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { historyError = new(ProjectOperationErrorCode.HistoryUnavailable, exception.Message); }
        finally { loadingState = false; await InvokeAsync(StateHasChanged); }
    }
    private async Task SelectMissionAsync(string mission)
    {
        if (sessionId is null || lifetime is null) return;
        var response = await ClientRuntime.SendAsync<SelectProjectMissionRequest, SelectProjectMissionResponse>(new(sessionId, mission), lifetime.Token);
        if (response.Error is { } error) submissionError = error;
        else if (response.Missions is { } missions && missionState is { } state) { missionState = state with { Missions = missions }; submissionError = null; }
    }
    private async Task StartRunAsync(string input)
    {
        if (sessionId is null || lifetime is null || missionState is null) return;
        submissionBusy = true;
        Guid? previous = missionState.Submission is { State: ProjectSubmissionState.Rejected } prior ? prior.CommandId : null;
        try
        {
            var response = await ClientRuntime.SendAsync<ForgeMission.ClientRuntime.Transport.StartProjectMissionRunRequest, ProjectSubmissionResponse>(new ForgeMission.ClientRuntime.Transport.StartProjectMissionRunRequest(sessionId, Guid.NewGuid(), previous, input), lifetime.Token);
            submissionError = response.Error;
            await RefreshStateAsync();
        }
        catch (Exception exception) { submissionError = new(ProjectOperationErrorCode.SubmissionUncertain, exception.Message); }
        finally { submissionBusy = false; await InvokeAsync(StateHasChanged); }
    }
    private async Task RetrySubmissionAsync(Guid commandId)
    {
        if (sessionId is null || lifetime is null) return;
        submissionBusy = true;
        try { var response = await ClientRuntime.SendAsync<RetryProjectMissionSubmissionRequest, ProjectSubmissionResponse>(new(sessionId, commandId), lifetime.Token); submissionError = response.Error; await RefreshStateAsync(); }
        catch (Exception exception) { submissionError = new(ProjectOperationErrorCode.SubmissionUncertain, exception.Message); }
        finally { submissionBusy = false; await InvokeAsync(StateHasChanged); }
    }
    private async Task OlderRunsAsync()
    {
        if (sessionId is null || lifetime is null || runs?.Next is not { } next) return;
        await LoadRunsAsync(next);
    }
    private async Task LatestRunsAsync() { runCursor = null; await RefreshStateAsync(forceLatest: true); }
    private async Task LoadRunsAsync(ProjectRunCursor? cursor)
    {
        if (sessionId is null || lifetime is null) return;
        var response = await ClientRuntime.SendAsync<GetProjectRunsRequest, GetProjectRunsResponse>(new(sessionId, cursor), lifetime.Token);
        if (response.Error is { } error) historyError = error;
        else if (response.Page is { } page) { runs = page; runCursor = cursor; historyError = null; }
    }
    private async Task LoadWorkbenchAsync()
    {
        if (sessionId is null || lifetime is null) return;
        var response = await ClientRuntime.SendAsync<GetProjectWorkbenchRequest, GetProjectWorkbenchResponse>(new(sessionId), lifetime.Token);
        workbench = response.Projection; workbenchError = response.Error;
    }
    private async Task OpenDocumentAsync(ProjectWorkbenchEntry entry)
    {
        if (sessionId is null || lifetime is null) return;
        view = WorkbenchView.Document; document = null; documentError = null;
        var response = await ClientRuntime.SendAsync<OpenProjectDocumentRequest, OpenProjectDocumentResponse>(new(sessionId, entry.Id), lifetime.Token);
        document = response.Document; documentError = response.Error;
    }
    private Task BackToExplorer() { view = WorkbenchView.Explorer; return Task.CompletedTask; }
    private async Task ShowInstructionAsync(Guid runId)
    {
        if (sessionId is null || lifetime is null) return;
        var response = await ClientRuntime.SendAsync<GetProjectRunRequest, GetProjectRunResponse>(new(sessionId, runId), lifetime.Token);
        if (response.Run is { } detail) expandedInstruction = detail.Input; else historyError = response.Error;
    }
    private void HideInstruction() => expandedInstruction = null;
    private async Task OpenTraceAsync(Guid runId)
    {
        if (sessionId is null || lifetime is null) return;
        view = WorkbenchView.RunTrace; selectedRun = null; traceEvents = null; traceError = null;
        var response = await ClientRuntime.SendAsync<GetProjectRunRequest, GetProjectRunResponse>(new(sessionId, runId), lifetime.Token);
        if (response.Run is not { } detail) { traceError = response.Error; return; }
        selectedRun = detail;
        await LatestTraceAsync();
    }
    private async Task LatestTraceAsync()
    {
        if (selectedRun is null) return;
        traceThrough = selectedRun.Run.LastSequence;
        traceAfter = Math.Max(selectedRun.Run.AcceptedSequence - 1, traceThrough - 200);
        await LoadTraceAsync();
    }
    private async Task EarlierTraceAsync()
    {
        if (selectedRun is null || traceAfter <= selectedRun.Run.AcceptedSequence - 1) return;
        traceThrough = traceAfter; traceAfter = Math.Max(selectedRun.Run.AcceptedSequence - 1, traceThrough - 200); await LoadTraceAsync();
    }
    private async Task LaterTraceAsync()
    {
        if (selectedRun is null || traceEvents?.HasMore != true) return;
        traceAfter = traceThrough; traceThrough = Math.Min(selectedRun.Run.LastSequence, traceAfter + 200); await LoadTraceAsync();
    }
    private async Task LoadTraceAsync()
    {
        if (sessionId is null || lifetime is null || selectedRun is null) return;
        var response = await ClientRuntime.SendAsync<GetProjectRunEventsRequest, GetProjectRunEventsResponse>(new(sessionId, selectedRun.Run.RunId, traceAfter, traceThrough), lifetime.Token);
        traceEvents = response.Page; traceError = response.Error;
    }
    private Task BackToMissions() { view = WorkbenchView.Missions; return Task.CompletedTask; }
    private async Task ConsumeEventsAsync(int ownerGeneration, CancellationToken ct)
    {
        try { await foreach (var evt in ClientRuntime.Subscribe(ct)) if (ownerGeneration == generation && evt.SessionId == sessionId && evt.Kind == ClientRuntimeEventKind.ProjectMissionChanged) await RefreshStateAsync(); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception exception) { if (ownerGeneration == generation) { connectionError = exception.Message; await InvokeAsync(StateHasChanged); } }
    }
    private async Task RestartSubscriptionAsync()
    {
        if (lifetime is null) return;
        connectionError = null;
        if (subscription is not null) await subscription;
        subscription = ConsumeEventsAsync(generation, lifetime.Token);
        await RefreshStateAsync();
    }
    private async Task StopLifetimeAsync()
    {
        if (lifetime is null) return;
        await lifetime.CancelAsync(); if (subscription is not null) await subscription; lifetime.Dispose(); lifetime = null; subscription = null;
    }
    private static bool Terminal(ConversationRunStatus status) => status is ConversationRunStatus.Completed or ConversationRunStatus.Failed or ConversationRunStatus.Interrupted or ConversationRunStatus.Rejected;
    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
    public async ValueTask DisposeAsync() => await StopLifetimeAsync();
}
<style>
.shell { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; background: var(--bg); color: var(--text); font-family: var(--font-sans); }
.shell-header { min-height: var(--wb-header-height); display: flex; align-items: center; padding: 0 var(--wb-page-inset) 0 var(--wb-header-inset); background: var(--surface-sunken); border-bottom: 1px solid var(--border-strong); } .brand { display: flex; align-items: baseline; gap: var(--space-4); } .brand h1, .subtitle { margin: 0; } .brand h1 { color: var(--accent); font-size: var(--font-size-display); } .brand-divider { align-self: stretch; width: 1px; background: var(--border-strong); } .subtitle { font-size: var(--font-size-title); }
.workbench { display: grid; grid-template-columns: var(--wb-rail-width) minmax(0, 1fr); grid-template-areas: "rail content"; min-height: 100vh; min-height: 100dvh; background: var(--bg); color: var(--text); font-family: var(--font-sans); } .wb-content { grid-area: content; display: flex; flex-direction: column; min-width: 0; min-height: 0; border-left: 1px solid var(--border-strong); } .wb-header { flex: none; min-width: 0; padding: var(--space-3) var(--wb-page-inset); background: var(--surface-sunken); border-bottom: 1px solid var(--border-strong); } .wb-header h1, .wb-header p { margin: 0; overflow-wrap: anywhere; } .wb-header h1 { font-size: var(--font-size-title); } .wb-header p { color: var(--text-muted); font-size: var(--font-size-mono); }
.wb-document { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: auto; padding: var(--wb-page-inset); } .composer-bar { flex: none; padding: var(--space-3) var(--wb-page-inset) calc(var(--space-3) + var(--safe-bottom)); border-top: 1px solid var(--border); background: var(--bg); } .connection-banner { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) var(--wb-page-inset); border-bottom: 1px solid var(--danger-border); background: var(--danger-bg); color: var(--danger); font-size: var(--font-size-meta); } .connection-banner button, .instruction-detail button, .new-runs { border: none; background: none; color: var(--accent); font: inherit; font-weight: 600; cursor: pointer; } .instruction-detail { width: var(--wb-run-content-width); max-width: 100%; align-self: center; margin-top: var(--space-3); padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); } .instruction-detail pre { max-height: 12rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; } .new-runs { align-self: center; margin-top: var(--space-3); }
@@media (max-width: 639px) { .workbench { grid-template-columns: minmax(7rem, 28%) minmax(0, 1fr); } }
</style>
