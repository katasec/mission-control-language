<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);3021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Parser\ForgeMission.Parser.csproj" />
    <ProjectReference Include="..\ForgeMission.Scout\ForgeMission.Scout.csproj" />
    <!-- Sibling checkout — same cross-repo pattern ForgeMission.Tests already uses for
         Katasec.AnthropicServer/OaiServer. Katasec.AITools has zero ASP.NET coupling
         (unlike AnthropicServer's FrameworkReference), so it's safe for the AOT binary. -->
    <ProjectReference Include="..\..\..\oai-server-dotnet\src\Katasec.AITools\Katasec.AITools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

</Project>
