<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Core\ForgeMission.Core.csproj" />
    <ProjectReference Include="..\ForgeMission.ChatClients\ForgeMission.ChatClients.csproj" />
    <ProjectReference Include="..\ForgeMission.Docker\ForgeMission.Docker.csproj" />
    <ProjectReference Include="..\ForgeMission.Scout\ForgeMission.Scout.csproj" />
    <ProjectReference Include="..\ForgeMission.Serve\ForgeMission.Serve.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="Katasec.OciClient" Version="0.2.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltinMissionReferences/vanilla.oci-ref"
                      LogicalName="ForgeMission.Cli.BuiltinMissionReferences.vanilla.oci-ref" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>forge</AssemblyName>
    <PublishAot>true</PublishAot>
    <!-- YamlDotNet uses reflection-based builders; our types are preserved via
         [DynamicDependency] so these warnings are safe to suppress. -->
    <IlcSuppressWarnings>IL3050</IlcSuppressWarnings>
    <NoWarn>$(NoWarn);IL3050;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <!-- Native AOT on macOS: system libs needed by the AOT runtime live under Homebrew -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <!-- LinkerArgs on a referenced library are not propagated to this executable's final AOT link. -->
    <LinkerArg Include="-Wl,-ld_classic" />
    <LinkerArg Include="-L/opt/homebrew/lib" />
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" />
  </ItemGroup>

</Project>
