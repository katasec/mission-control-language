@* The Mission Chat prototype (47.1). Everything it shows is fixed stand-in content held in this
   file, and everything a person changes is local view state that dies with the component: no
   request, no durable command, no generated identifier, no projection of a Mission, conversation,
   turn, run, approval, activity or trace. Reloading returns to the startup choice because this
   component is rebuilt from scratch, which is the prototype's contract rather than a recovery path.

   It composes the shipped rail unchanged and states everything else through the Workbench theme
   map. Binding references, at 1440x960:
     docs/design/assets/mission-chat-experience-v1/02-new-janus-chat.png  (fresh chat)
     docs/design/assets/mission-chat-experience-v1/03-active-chat.png     (active chat)

   Three destinations in the frames have no static screen this phase designs: the two rail entries
   other than Missions, and the chat rows other than the selected one. They stay visible, because
   they are the navigation structure the references draw, and they answer — politely, in the live
   region — rather than doing nothing at all. Silence would be the dishonest option, and inventing
   a destination would be the worse one. *@

<div class="mcp-shell">
    <WorkbenchRail ProjectTitle="@ProjectName" Selected="WorkbenchView.Missions" SelectedChanged="OnRailSelected" />

    <section class="mcp-content">
        <header class="mcp-header">
            <div class="mcp-header-text">
                <h1>Missions</h1>
                <p>Chats live under the mission version they pinned.</p>
            </div>
            <button type="button" class="mcp-header-secondary" @onclick="OnAuthorMission">Author a mission</button>
            <button type="button" class="mcp-header-action" @onclick="StartNewChat">New chat</button>
        </header>

        <main class="mcp-document">
            <div class="mcp-columns">
                @ChatList
                @ChatPane
            </div>
        </main>

        @* The one place a local change is announced. Every transition below writes here rather
           than relying on a visual difference a screen reader would never reach. *@
        <p class="mcp-announce" role="status" aria-live="polite">@announcement</p>
    </section>
</div>

@code {
    // ── Local view state. These four fields are the whole of it. ───────────────────────────────
    private string selectedKey = NewChatKey;
    private List<ChatEntry> entries = [];
    private string draft = string.Empty;
    private string? announcement;
    private ElementReference composer;

    /// <summary>Raised when a person leaves the prototype for the unchanged Project launcher.
    /// Authoring a mission needs a Project, so this surface sends them to where that happens
    /// rather than pretending to host it.</summary>
    [Parameter] public EventCallback AuthorMission { get; set; }

    private bool OnFreshChat => selectedKey == NewChatKey;

    // ── The list column ────────────────────────────────────────────────────────────────────────

    private RenderFragment ChatList => @<div class="mcp-list">
        <div class="mcp-list-head">
            <h2>Chats</h2>
            <p>Grouped beneath their mission.</p>
        </div>
        @foreach (var group in OnFreshChat ? FreshChatGroups : ActiveChatGroups)
        {
            <p class="mcp-group-label">@group.Label</p>
            <ul class="mcp-rows">
                @foreach (var row in group.Rows)
                {
                    <li>@Row(row)</li>
                }
            </ul>
        }
    </div>;

    // Real markup rather than a RenderTreeBuilder fragment: Blazor stamps the scoped-CSS attribute
    // onto elements written in the template only, so a hand-built fragment would render unstyled.
    private RenderFragment Row(ChatRow row) =>
        @<button type="button"
                 class="@(row.Key == selectedKey ? "mcp-row mcp-row-current" : "mcp-row")"
                 aria-current="@(row.Key == selectedKey ? "true" : null)"
                 @onclick="() => SelectChat(row)">
             <span class="mcp-row-title">@row.Title</span>
             <span class="mcp-row-meta">@row.Meta</span>
         </button>;

    // ── The chat column ────────────────────────────────────────────────────────────────────────

    private RenderFragment ChatPane => @<div class="mcp-chat">
        <header class="mcp-chat-head">
            <div class="mcp-chat-head-text">
                <h2>@(OnFreshChat ? "New chat" : LaunchPlanTitle)</h2>
                <p>@(OnFreshChat ? FreshSubtitle : ActiveSubtitle)</p>
            </div>
            <span class="mcp-chip mcp-chip-approved">APPROVED</span>
            <span class="mcp-chip mcp-chip-pinned">PINNED · JANUS V1.4</span>
        </header>

        <div class="mcp-body">
            @if (entries.Count == 0)
            {
                @Introduction
            }
            else
            {
                <div class="mcp-transcript">
                    @foreach (var entry in entries)
                    {
                        @Entry(entry)
                    }
                </div>
            }
        </div>

        <div class="mcp-composer">
            @* The placeholder is not a label, so the field carries its own. *@
            <textarea class="mcp-composer-field" @ref="composer"
                      aria-label="@(OnFreshChat ? FreshPlaceholder : ActivePlaceholder)"
                      placeholder="@(OnFreshChat ? FreshPlaceholder : ActivePlaceholder)"
                      value="@draft" @oninput="OnDraftInput" @onkeyup="OnComposerKeyUp"></textarea>
            <button type="button" class="mcp-send" @onclick="SendAsync">Send</button>
        </div>
    </div>;

    private RenderFragment Introduction => @<div class="mcp-intro">
        <div class="mcp-participants">
            <p class="mcp-participants-label">WHO IS IN THIS CHAT</p>
            @foreach (var participant in Participants)
            {
                <div class="mcp-participant">
                    <span class="mcp-avatar" aria-hidden="true">@participant.Initials</span>
                    <span class="mcp-participant-text">
                        <span class="mcp-participant-name">@participant.Name</span>
                        <span class="mcp-participant-role">@participant.Role</span>
                    </span>
                </div>
            }
        </div>

        @* Read-only by construction: a block of text containing no control at all, exactly as the
           shipped creation panel states the same fact. *@
        <div class="mcp-access">
            <p class="mcp-access-label">FIXED ACCESS</p>
            <p class="mcp-access-profile">Project workspace access</p>
            <p class="mcp-access-copy">This exact profile is fixed for this chat. Forge asks before any bounded operation. It cannot be changed here.</p>
        </div>

        <p class="mcp-intro-note">Send the first message to start. Everything the three of you say stays in this one chat.</p>
    </div>;

    private RenderFragment Entry(ChatEntry entry) => entry.Kind switch
    {
        ChatEntryKind.Day => @<p class="mcp-day">@entry.Text</p>,
        ChatEntryKind.User => @<p class="mcp-user-bubble">@entry.Text</p>,
        ChatEntryKind.Approval => @<p class="mcp-approval">@entry.Text</p>,
        ChatEntryKind.Tool => @<p class="mcp-tool-row"><span class="mcp-tool-glyph" aria-hidden="true">✓</span><span>@entry.Text</span></p>,
        ChatEntryKind.Activity => @<p class="mcp-activity"><span class="mcp-activity-dot" aria-hidden="true"></span><span>@entry.Text</span><span class="mcp-activity-dots" aria-hidden="true"><span></span><span></span><span></span></span></p>,
        _ => @<article class="mcp-participant-bubble">
                  <p class="mcp-participant-label">@entry.Speaker</p>
                  <p class="mcp-participant-lead">@entry.Text</p>
                  @if (entry.Bullets is { Length: > 0 } bullets)
                  {
                      <ul class="mcp-participant-bullets">
                          @foreach (var bullet in bullets)
                          {
                              <li>@bullet</li>
                          }
                      </ul>
                  }
              </article>,
    };

    // ── Transitions. Every one of them is local; none reaches a service. ───────────────────────

    private Task OnAuthorMission() => AuthorMission.InvokeAsync();

    private void StartNewChat()
    {
        selectedKey = NewChatKey;
        entries = [];
        draft = string.Empty;
        announcement = "Started a new local chat pinned to Janus v1.4.";
    }

    private void SelectChat(ChatRow row)
    {
        // Re-selecting the open chat is not a reset: it would silently discard what a person just
        // added to it.
        if (row.Key == selectedKey) return;

        if (row.Key != LaunchPlanKey)
        {
            Defer(row.Title);
            return;
        }

        selectedKey = LaunchPlanKey;
        entries = [.. LaunchPlanTranscript];
        draft = string.Empty;
        announcement = $"Opened the {LaunchPlanTitle} chat.";
    }

    private void OnRailSelected(WorkbenchView destination)
    {
        // Missions is already current, so the rail's own selected state never moves.
        if (destination == WorkbenchView.Missions) return;
        Defer(RailLabel(destination));
    }

    private void Defer(string label) => announcement = $"{label} is not part of this preview.";

    private void OnDraftInput(ChangeEventArgs e) => draft = e.Value?.ToString() ?? string.Empty;

    // Enter sends on key-up rather than key-down: preventing the key-down default is the only way
    // to stop the newline, and Blazor's preventDefault is static — it would suppress Shift+Enter's
    // newline too. By key-up the character is already in the field, so the send path trims the
    // newline Enter just added and Shift+Enter keeps the one it meant to add.
    private async Task OnComposerKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendAsync();
    }

    private async Task SendAsync()
    {
        var message = draft.Trim();
        if (message.Length == 0) return;

        // The seeded chat ends on "Proposer is revising the plan". Clearing it before the new rows
        // land keeps the column chronological instead of stranding a stale cue above fresh text.
        var seededActivity = entries.FindIndex(entry => entry.Kind == ChatEntryKind.Activity);
        if (seededActivity >= 0) entries.RemoveAt(seededActivity);

        entries.Add(new(ChatEntryKind.User, null, message, null));
        entries.Add(ProposerReply);
        entries.Add(ApproverReply);

        draft = string.Empty;
        announcement = "Message added. Proposer and Approver replied in this preview.";
        await composer.FocusAsync();
    }

    private static string RailLabel(WorkbenchView destination) =>
        destination == WorkbenchView.Explorer ? "Project Explorer" : "Settings";

    // ── Fixed stand-in content. None of it is a Mission, conversation, turn, run or approval. ──

    private const string ProjectName = "Atlas Beta";
    private const string NewChatKey = "new-chat";
    private const string LaunchPlanKey = "launch-plan";
    private const string LaunchPlanTitle = "Launch plan";
    private const string FreshSubtitle = "This chat is fixed to the mission version below. Choosing a version happens once, here at the start.";
    private const string ActiveSubtitle = "You · Proposer · Approver — one shared chat";
    private const string FreshPlaceholder = "Message Janus v1.4…";
    private const string ActivePlaceholder = "Message the chat…";
    private const string JanusGroup = "JANUS · V1.4 · APPROVED";
    private const string NaiveGroup = "NAIVE · V2.1 · APPROVED";

    private enum ChatEntryKind { Day, User, Participant, Approval, Tool, Activity }

    private sealed record ChatRow(string Key, string Title, string Meta);
    private sealed record ChatGroup(string Label, ChatRow[] Rows);
    private sealed record ChatEntry(ChatEntryKind Kind, string? Speaker, string Text, string[]? Bullets);
    private sealed record Participant(string Initials, string Name, string Role);

    private static readonly ChatGroup[] FreshChatGroups =
    [
        new(JanusGroup,
        [
            new(NewChatKey, "New chat", "No messages yet"),
            new(LaunchPlanKey, LaunchPlanTitle, "Updated today"),
            new("migration-rehearsal", "Migration rehearsal", "Updated yesterday"),
        ]),
        new(NaiveGroup, [new("docs-sweep", "Docs sweep", "3 days ago")]),
    ];

    private static readonly ChatGroup[] ActiveChatGroups =
    [
        new(JanusGroup,
        [
            new(LaunchPlanKey, LaunchPlanTitle, "Updated today · 8 messages"),
            new("migration-rehearsal", "Migration rehearsal", "Updated yesterday"),
            new("risk-review", "Risk review", "4 days ago"),
        ]),
        new(NaiveGroup, [new("docs-sweep", "Docs sweep", "3 days ago")]),
    ];

    private static readonly Participant[] Participants =
    [
        new("MK", "You", "You steer the work with ordinary messages and decide what happens next."),
        new("P", "Proposer", "Drafts and revises the work this mission version defines."),
        new("A", "Approver", "Checks each proposal against the mission's approval rules and says why."),
    ];

    private static readonly ChatEntry[] LaunchPlanTranscript =
    [
        new(ChatEntryKind.Day, null, "Today", null),
        new(ChatEntryKind.User, null, "Draft the launch plan for the Atlas beta. Two weeks, no new infrastructure.", null),
        new(ChatEntryKind.Participant, "Proposer", "Two-week plan, split by what has to be true before we open the beta.",
        [
            "Week 1 — freeze the schema, finish the seed importer, run one full restore drill.",
            "Week 2 — 40-account soak, then invite the first cohort behind the existing flag.",
            "Rollback stays a flag flip; no migration lands inside the beta window.",
        ]),
        new(ChatEntryKind.Participant, "Approver", "Checked against the mission's rules. The restore drill has a named owner and the rollback path is reversible, so this meets the bar. The soak window is the only part with no slack.", null),
        new(ChatEntryKind.Approval, null, "Approved — reversible rollback, named owner for the restore drill.", null),
        new(ChatEntryKind.Tool, null, "Wrote docs/launch/atlas-beta-plan.md", null),
        new(ChatEntryKind.User, null, "Give week two three days of slack and move the cohort invite to the Thursday.", null),
        new(ChatEntryKind.Activity, null, "Proposer is revising the plan", null),
    ];

    // The one reply pair, used verbatim for every send. Neither line claims an approval outcome, a
    // model, a run, a trace, or anything durable.
    private static readonly ChatEntry ProposerReply = new(ChatEntryKind.Participant, "Proposer",
        "I have updated the proposed sequencing: week two now has three days of slack and the cohort invite moves to Thursday.", null);

    private static readonly ChatEntry ApproverReply = new(ChatEntryKind.Participant, "Approver",
        "The revised scenario keeps the rollback boundary and named restore owner in view.", null);
}
