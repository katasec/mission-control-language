@namespace ForgeMission.Presentation.Components
@using ForgeMission.Application.Transport
@using ForgeMission.Presentation
@using ForgeMission.Conversations.Contracts
@using MissionConversationDetail = ForgeMission.Application.Transport.MissionConversationDetail

<section class="mconversation">
 <header class="mconversation-head"><button type="button" @onclick="Back">← Missions</button><div><h2>Mission conversation</h2><p>v@Detail.Conversation.VersionNumber · @Detail.Conversation.Profile · pinned</p></div></header>
 <ConversationTranscriptView Entries="Transcript.Entries" />
 <section class="mconversation-turns">@foreach (var turn in Detail.Turns) { <button type="button" @onclick="() => Trace.InvokeAsync((turn.TurnId, turn.TurnAttemptId))">View trace for turn</button> @if (turn.Status is ConversationRunStatus.Failed or ConversationRunStatus.Interrupted) { <button type="button" @onclick="() => Retry.InvokeAsync(turn.TurnId)">Retry turn</button> } }</section>
 @if (ActiveTurn is { } active) { <section class="mconversation-running" aria-live="polite">Mission is working on this turn. <button type="button" @onclick="() => Cancel.InvokeAsync((active.TurnId, active.TurnAttemptId))">Cancel turn</button></section> }
 <footer class="mconversation-compose"><textarea @bind="draft" @bind:event="oninput" disabled="@(ActiveTurn is not null)" aria-label="Mission message" placeholder="Message this mission"></textarea><button type="button" @onclick="Send" disabled="@(ActiveTurn is not null || string.IsNullOrWhiteSpace(draft))">Send</button></footer>
</section>
@code {
 [Parameter, EditorRequired] public MissionConversationDetail Detail { get; set; } = default!;
 [Parameter] public EventCallback Back { get; set; }
 [Parameter] public EventCallback<string> Submit { get; set; }
 [Parameter] public EventCallback<(Guid TurnId, Guid AttemptId)> Cancel { get; set; }
 [Parameter] public EventCallback<(Guid TurnId, Guid AttemptId)> Trace { get; set; }
 [Parameter] public EventCallback<Guid> Retry { get; set; }
 private readonly ConversationTranscript Transcript = new(); private string draft = string.Empty;
 private MissionTurnView? ActiveTurn => Detail.Turns.LastOrDefault(turn => turn.Status is ConversationRunStatus.Queued or ConversationRunStatus.Running or ConversationRunStatus.WaitingForTool);
 protected override void OnParametersSet() { foreach (var item in Detail.Events) Transcript.Apply(item); }
 private async Task Send() { if (!string.IsNullOrWhiteSpace(draft)) { var message = draft; draft = string.Empty; await Submit.InvokeAsync(message); } }
}
<style>
.mconversation { width:min(100%, 64rem); align-self:center; display:flex; flex:1; flex-direction:column; gap:var(--space-4); min-height:0; } .mconversation-head { display:flex; gap:var(--space-3); align-items:center; } .mconversation-head button,.mconversation-running button,.mconversation-turns button { border:0; background:none; color:var(--accent); font:inherit; font-weight:600; cursor:pointer; } .mconversation-head h2,.mconversation-head p { margin:0; } .mconversation-head p { color:var(--text-muted); font-size:var(--font-size-meta); } .mconversation-running { padding:var(--space-3); border:1px solid var(--warning); border-radius:var(--radius); background:var(--warning-bg); color:var(--warning); } .mconversation-turns { display:flex; gap:var(--space-3); flex-wrap:wrap; } .mconversation-compose { display:flex; gap:var(--space-2); align-items:end; padding-top:var(--space-3); border-top:1px solid var(--border); } .mconversation-compose textarea { flex:1; min-height:4rem; resize:vertical; background:var(--surface); color:var(--text); border:1px solid var(--border-strong); border-radius:var(--radius); padding:var(--space-3); font:inherit; } .mconversation-compose button { border:0; border-radius:var(--radius); background:var(--accent); color:var(--accent-contrast); padding:var(--space-2) var(--space-3); font:inherit; font-weight:600; } .mconversation-compose button:disabled,.mconversation-compose textarea:disabled { opacity:.55; }
</style>
