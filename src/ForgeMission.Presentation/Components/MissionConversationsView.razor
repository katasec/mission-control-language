@namespace ForgeMission.Presentation.Components
@using ForgeMission.Application.Transport
@using MissionConversationRecord = ForgeMission.Application.Transport.MissionConversationView

<section class="mcv">
    <header class="mcv-head"><div><h2>Mission conversations</h2><p>Continue an approved mission over time.</p></div><button type="button" class="mcv-primary" @onclick="TogglePicker">New mission conversation</button></header>
    @if (Error is not null) { <section class="mcv-error" role="alert">@Error.Message <button type="button" @onclick="Refresh">Retry</button></section> }
    @if (PickerOpen)
    {
        <section class="mcv-picker" aria-label="New mission conversation">
            <h3>Choose an approved mission</h3>
            @foreach (var version in Versions)
            {
                <button type="button" class="@(version.MissionVersionId == SelectedVersionId ? "mcv-version selected" : "mcv-version")" @onclick="() => SelectedVersionId = version.MissionVersionId">
                    <strong>@version.Name v@version.VersionNumber</strong><span>Approved · @version.Profile</span>
                </button>
            }
            @if (Selected is { } selected)
            {
                <section class="mcv-approval"><h3>Mission access</h3><p>This conversation will use the fixed <strong>@selected.Profile</strong> profile. You cannot change its tools here.</p><button type="button" class="mcv-primary" @onclick="Start">Start conversation on @selected.Name v@selected.VersionNumber</button><button type="button" class="mcv-quiet" @onclick="TogglePicker">Decline</button></section>
            }
        </section>
    }
    @if (Conversations.Count == 0) { <p class="mcv-empty">Start a mission conversation to see it here.</p> }
    else { <ol class="mcv-list">@foreach (var conversation in Conversations) { <li><button type="button" class="mcv-row" @onclick="() => Open.InvokeAsync(conversation.ConversationId)"><strong>Mission v@conversation.VersionNumber</strong><span>@conversation.Profile · @conversation.Status</span><time>@conversation.UpdatedAtUtc.LocalDateTime.ToShortTimeString()</time></button></li> }</ol> }
    <button type="button" class="mcv-author" @onclick="Author">Author a mission</button>
</section>

@code {
    [Parameter] public IReadOnlyList<MissionConversationRecord> Conversations { get; set; } = [];
    [Parameter] public IReadOnlyList<MissionVersionPickerItem> Versions { get; set; } = [];
    [Parameter] public ProjectOperationError? Error { get; set; }
    [Parameter] public EventCallback<Guid> Open { get; set; }
    [Parameter] public EventCallback<Guid> Create { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public EventCallback Author { get; set; }
    private bool PickerOpen;
    private Guid? SelectedVersionId;
    private MissionVersionPickerItem? Selected => Versions.SingleOrDefault(item => item.MissionVersionId == SelectedVersionId);
    private void TogglePicker() { PickerOpen = !PickerOpen; if (PickerOpen) SelectedVersionId = Versions.FirstOrDefault()?.MissionVersionId; }
    private async Task Start() { if (Selected is not null) await Create.InvokeAsync(Selected.MissionId); }
}

<style>
.mcv { width: min(100%, 72rem); align-self: center; display:flex; flex-direction:column; gap:var(--space-4); } .mcv-head { display:flex; gap:var(--space-4); justify-content:space-between; align-items:start; } .mcv-head h2,.mcv-head p { margin:0; } .mcv-head p,.mcv-row span,.mcv-row time { color:var(--text-muted); font-size:var(--font-size-meta); } .mcv-primary { border:0; border-radius:var(--radius); background:var(--accent); color:var(--accent-contrast); padding:var(--space-2) var(--space-3); font:inherit; font-weight:600; cursor:pointer; } .mcv-picker,.mcv-error { padding:var(--space-4); border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface); display:flex; flex-direction:column; gap:var(--space-2); } .mcv-error { border-color:var(--danger-border); background:var(--danger-bg); color:var(--danger); } .mcv-error button,.mcv-quiet,.mcv-author { border:0; background:none; color:var(--accent); font:inherit; font-weight:600; text-align:left; cursor:pointer; } .mcv-version { display:flex; flex-direction:column; gap:var(--space-1); text-align:left; border:1px solid var(--border); border-radius:var(--radius); background:var(--surface); color:var(--text); padding:var(--space-3); cursor:pointer; } .mcv-version.selected { border-color:var(--accent); background:var(--accent-soft); } .mcv-approval { display:flex; flex-direction:column; gap:var(--space-2); padding:var(--space-3); background:var(--surface-sunken); border-radius:var(--radius); } .mcv-approval h3,.mcv-approval p { margin:0; } .mcv-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; } .mcv-row { display:grid; grid-template-columns:1fr auto auto; width:100%; gap:var(--space-3); padding:var(--space-3) var(--space-4); border:0; border-bottom:1px solid var(--border); background:var(--surface); color:var(--text); text-align:left; cursor:pointer; } .mcv-row:hover { background:var(--surface-hover); } .mcv-empty { color:var(--text-subtle); text-align:center; padding:var(--space-6); }
</style>
