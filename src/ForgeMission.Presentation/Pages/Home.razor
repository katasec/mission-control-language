.wb-document { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: auto; padding: var(--ml-region-top, var(--wb-page-inset)) var(--wb-page-inset) calc(var(--wb-page-inset) + var(--safe-bottom)); } .wb-announce { flex: none; margin: 0; padding: 0 var(--wb-page-inset); color: var(--text-muted); font-size: var(--font-size-meta); } .wb-announce:empty { display: none; } .connection-banner { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) var(--wb-page-inset); border-bottom: 1px solid var(--danger-border); background: var(--danger-bg); color: var(--danger); font-size: var(--font-size-meta); } .connection-banner button { border: none; background: none; color: var(--accent); font: inherit; font-weight: 600; cursor: pointer; }
@@media (max-width: 639px) { .workbench { grid-template-columns: minmax(7rem, 28%) minmax(0, 1fr); } }
