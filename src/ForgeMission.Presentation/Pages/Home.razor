@page "/"
@* Contracts and Transport each name a list/create pair for mission conversations, because each
   owns one side of it. These aliases pick the surface side without renaming a durable contract. *@
@using SurfaceListMissionConversationsRequest = ForgeMission.Application.Transport.ListMissionConversationsRequest
@using SurfaceListMissionConversationsResponse = ForgeMission.Application.Transport.ListMissionConversationsResponse
@using SurfaceCreateMissionConversationRequest = ForgeMission.Application.Transport.CreateMissionConversationRequest
@using SurfaceCreateMissionConversationResponse = ForgeMission.Application.Transport.CreateMissionConversationResponse
@inject IApplicationChannel ApplicationChannel
@implements IAsyncDisposable

@if (project is null)
{
    <div class="shell launcher-shell">
        <header class="shell-header"><div class="brand"><h1>Forge</h1><span class="brand-divider"></span><p class="subtitle">AI Workbench</p></div></header>
        <ProjectLauncher Goal="@goalInput" GoalChanged="value => goalInput = value" Title="@titleInput" TitleChanged="value => titleInput = value" Home="@homeInput" HomeChanged="value => homeInput = value" Busy="busy" Error="@launcherError" Notice="@LauncherNotice" ShowOpenFolder="showOpenFolder" OpenPath="@openPathInput" OpenPathChanged="value => openPathInput = value" GoalCommitted="DraftProjectAsync" Create="CreateProjectAsync" OpenRequested="ToggleOpenFolder" Open="OpenProjectAsync" />
    </div>
}
else
{
    <div class="workbench" data-surface-theme="forge-desktop-dark">
        <WorkbenchRail ProjectTitle="@project.Title" Selected="view" SelectedChanged="ChangeViewAsync" />
        <section class="wb-content">
            <header class="wb-header">
                <div class="wb-header-text"><h1>@HeaderTitle</h1><p>@HeaderSubtitle</p></div>
                @if (view == WorkbenchView.Missions && !newConversationOpen)
                {
                    <button type="button" class="wb-header-action" @onclick="OpenNewConversationAsync">New conversation</button>
                }
            </header>
            @if (connectionError is not null) { <div class="connection-banner"><span>Connection lost: @connectionError</span><button type="button" @onclick="RestartSubscriptionAsync">Retry</button></div> }
            <main class="wb-document">
                @switch (view)
                {
                    case WorkbenchView.Explorer:
                        <ProjectExplorerView Projection="workbench" Runs="runs" Error="workbenchError" EntrySelected="OpenDocumentAsync" TraceRequested="OpenTraceAsync" />
                        break;
                    case WorkbenchView.Document:
                        <ProjectDocumentView Document="document" Error="documentError" Back="BackToExplorer" />
                        break;
                    case WorkbenchView.Settings:
                        <WorkbenchSettings />
                        break;
                    case WorkbenchView.RunTrace:
                        <RunTraceView Run="selectedRun" Events="traceEvents" AfterSequence="traceAfter" ThroughSequence="traceThrough" Error="traceError" Back="BackToMissions" Earlier="EarlierTraceAsync" Later="LaterTraceAsync" Latest="LatestTraceAsync" />
                        break;
                    default:
                        <MissionsLandingView Conversations="conversations" Error="conversationsError" Retry="LoadConversationsAsync" Panel="@NewConversationPanel" />
                        break;
                }
            </main>
            <p class="wb-announce" role="status" aria-live="polite">@announcement</p>
        </section>
    </div>
}

@code {
    private ProjectSummary? project;
    private string? sessionId;
    private WorkbenchView view = WorkbenchView.Missions;
    private ProjectMissionState? missionState;
    private ProjectRunPage? runs;
    private ProjectRunCursor? runCursor;
    private ProjectOperationError? historyError;
    private ProjectWorkbenchProjection? workbench;
    private ProjectOperationError? workbenchError;
    private ProjectDocument? document;
    private ProjectOperationError? documentError;
    // Missions landing (45.3 task 3A). Presentation state only: what was returned, what is
    // selected, what is in flight. No durable or Project fact is cached or derived here.
    private IReadOnlyList<MissionConversationListItem>? conversations;
    private ProjectOperationError? conversationsError;
    private IReadOnlyList<ApprovedMissionVersionOption>? approvedVersions;
    private ProjectOperationError? approvedVersionsError;
    private ProjectOperationError? createError;
    private bool newConversationOpen;
    private bool creating;
    private Guid createCommandId;
    private string? announcement;

    private ProjectRunDetail? selectedRun;
    private ProjectRunEventPage? traceEvents;
    private ProjectOperationError? traceError;
    private long traceAfter;
    private long traceThrough;

    private string goalInput = string.Empty;
    private string titleInput = string.Empty;
    private string homeInput = string.Empty;
    private string openPathInput = string.Empty;
    private bool goalRequired;
    private bool showOpenFolder;
    private bool busy;
    private string? launcherError;
    private string? LauncherNotice => goalRequired ? "That folder is not a Forge Project yet. Enter a goal to create one there." : null;

    private CancellationTokenSource? lifetime;
    private Task? subscription;
    private int generation;
    private string? connectionError;

    private string HeaderTitle => view switch { WorkbenchView.Explorer or WorkbenchView.Document => "Project Explorer", WorkbenchView.Settings => "Settings", WorkbenchView.RunTrace => "Run trace", _ => "Missions" };
    private string HeaderSubtitle => view == WorkbenchView.Missions
        ? "Review pinned mission versions and start a new conversation."
        : project?.Title ?? string.Empty;

    private RenderFragment? NewConversationPanel => newConversationOpen
        ? @<NewMissionConversationPanel Options="approvedVersions" OptionsError="approvedVersionsError" Error="createError"
                                        Busy="creating" Start="StartConversationAsync" Cancel="CloseNewConversation"
                                        RetryOptions="LoadApprovedVersionsAsync" />
        : null;

    private void ToggleOpenFolder() { showOpenFolder = !showOpenFolder; launcherError = null; }
    private async Task DraftProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(goalInput)) { launcherError = "Enter a goal to start."; return; }
        var response = await LauncherAsync(token => ApplicationChannel.SendAsync<ProjectDraftRequest, ProjectDraftResponse>(new(goalInput, Blank(titleInput), Blank(homeInput)), token));
        if (response?.Draft is { } draft) { titleInput = draft.ProposedTitle; homeInput = draft.HomePath; }
        else if (response?.Error is { } error) launcherError = error.Message;
    }
    private async Task CreateProjectAsync()
    {
        var response = await LauncherAsync(token => ApplicationChannel.SendAsync<ProjectCreateRequest, ProjectOperationResponse>(new(goalInput, Blank(titleInput), Blank(homeInput)), token));
        if (response is not null) await ApplyProjectAsync(response);
    }
    private async Task OpenProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(openPathInput)) { launcherError = "Enter a folder to open."; return; }
        var response = await LauncherAsync(token => ApplicationChannel.SendAsync<ProjectOpenRequest, ProjectOperationResponse>(new(openPathInput), token));
        if (response is not null) await ApplyProjectAsync(response);
    }
    private async Task<T?> LauncherAsync<T>(Func<CancellationToken, Task<T>> operation) where T : class
    {
        busy = true; launcherError = null;
        try { return await operation(CancellationToken.None); }
        catch (Exception exception) { launcherError = exception.Message; return null; }
        finally { busy = false; }
    }
    private async Task ApplyProjectAsync(ProjectOperationResponse response)
    {
        if (response.Outcome is ProjectOperationOutcome.Created or ProjectOperationOutcome.Opened && response.Session is { } opened) { await EnterProjectAsync(opened); return; }
        if (response.Outcome == ProjectOperationOutcome.GoalRequired && response.Proposal is { } proposal) { goalRequired = true; showOpenFolder = false; titleInput = proposal.ProposedTitle; homeInput = proposal.HomePath; return; }
        showOpenFolder = false; launcherError = response.Error?.Message ?? "The application returned no Project.";
    }
    private async Task EnterProjectAsync(ProjectSession opened)
    {
        await StopLifetimeAsync();
        generation++;
        project = opened.Project; sessionId = opened.SessionId; view = WorkbenchView.Missions;
        lifetime = new CancellationTokenSource();
        subscription = ConsumeEventsAsync(generation, lifetime.Token);
        ResetMissionsLanding();
        await RefreshStateAsync(forceLatest: true);
        await LoadConversationsAsync();
        await LoadApprovedVersionsAsync();
    }

    private void ResetMissionsLanding()
    {
        conversations = null; conversationsError = null;
        approvedVersions = null; approvedVersionsError = null;
        createError = null; announcement = null;
        newConversationOpen = false; creating = false; createCommandId = Guid.Empty;
    }
    private async Task ChangeViewAsync(WorkbenchView next)
    {
        view = next;
        if (next == WorkbenchView.Explorer) await LoadWorkbenchAsync();
    }
    private async Task RefreshStateAsync(bool forceLatest = false)
    {
        if (sessionId is null || lifetime is null) return;
        try
        {
            var response = await ApplicationChannel.SendAsync<GetProjectMissionStateRequest, GetProjectMissionStateResponse>(new(sessionId), lifetime.Token);
            if (response.Error is { } error) { historyError = error; return; }
            if (response.State is not { } state) return;
            missionState = state;
            historyError = state.HistoryError;
            if (state.Runs is { } page && (forceLatest || runCursor is null)) { runs = page; runCursor = null; }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { historyError = new(ProjectOperationErrorCode.HistoryUnavailable, exception.Message); }
        finally { await InvokeAsync(StateHasChanged); }
    }
    // ── Missions landing (45.3 task 3A) ────────────────────────────────────────────────────
    // Every branch below renders what Application returned. Nothing here decides which version is
    // approved, what a profile permits, or whether an attachment exists.

    private async Task LoadConversationsAsync()
    {
        if (sessionId is null || lifetime is null) return;
        conversationsError = null;
        try
        {
            var response = await ApplicationChannel.SendAsync<SurfaceListMissionConversationsRequest, SurfaceListMissionConversationsResponse>(new(sessionId), lifetime.Token);
            if (response.Error is { } error) { conversationsError = error; return; }
            conversations = response.Conversations ?? [];
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { conversationsError = new(ProjectOperationErrorCode.HistoryUnavailable, exception.Message); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadApprovedVersionsAsync()
    {
        if (sessionId is null || lifetime is null) return;
        approvedVersionsError = null;
        try
        {
            var response = await ApplicationChannel.SendAsync<ListApprovedMissionVersionsRequest, ListApprovedMissionVersionsResponse>(new(sessionId), lifetime.Token);
            if (response.Error is { } error) { approvedVersionsError = error; return; }
            approvedVersions = response.Options ?? [];
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { approvedVersionsError = new(ProjectOperationErrorCode.HistoryUnavailable, exception.Message); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task OpenNewConversationAsync()
    {
        newConversationOpen = true; createError = null; announcement = null;
        // A new command identity per opening, so a retry inside one attempt is idempotent while a
        // fresh attempt is genuinely a fresh create.
        createCommandId = Guid.NewGuid();
        await LoadApprovedVersionsAsync();
    }

    private void CloseNewConversation()
    {
        newConversationOpen = false; createError = null; creating = false; createCommandId = Guid.Empty;
    }

    /// <summary>Creating and attaching are two outcomes, and this reports them as two. A durable
    /// conversation that could not attach local hands is still a real conversation: it is listed
    /// and named, never hidden, and acknowledgement is never retried on its own.</summary>
    private async Task StartConversationAsync(ApprovedMissionVersionOption option)
    {
        if (sessionId is null || lifetime is null || creating) return;
        creating = true; createError = null; announcement = null;
        if (createCommandId == Guid.Empty) createCommandId = Guid.NewGuid();
        try
        {
            var created = await ApplicationChannel.SendAsync<SurfaceCreateMissionConversationRequest, SurfaceCreateMissionConversationResponse>(
                new(sessionId, option.MissionId, createCommandId, option.MissionVersionId), lifetime.Token);
            if (created.Error is { } refused)
            {
                createError = refused;
                await LoadApprovedVersionsAsync();
                return;
            }
            if (created.Created is not { } conversation) return;

            var attached = await AcknowledgeAsync(conversation);
            CloseNewConversation();
            announcement = attached
                ? $"Conversation created on {option.MissionName} v{option.VersionNumber}."
                : "Conversation created. Local access could not be confirmed. Open it later to reconnect its fixed access.";
            await LoadConversationsAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            // The request left; its outcome did not come back. The same command id and the same
            // selection are kept, so pressing Start again asks the identical question and Host
            // idempotency answers it once.
            createError = new(ProjectOperationErrorCode.SubmissionUncertain,
                $"We could not confirm whether the conversation was created. Retry. ({exception.Message})");
        }
        finally { creating = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task<bool> AcknowledgeAsync(CreatedMissionConversation conversation)
    {
        if (sessionId is null || lifetime is null) return false;
        var approval = conversation.Approval;
        try
        {
            var response = await ApplicationChannel.SendAsync<AcknowledgeMissionHandsRequest, AcknowledgeMissionHandsResponse>(
                new(sessionId, conversation.ConversationId, approval.MissionVersionId, approval.VersionNumber,
                    approval.DefinitionHash, ProfileAccepted: true), lifetime.Token);
            return response.AttachmentId is not null;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return false; }
        catch { return false; }
    }

    private async Task OlderRunsAsync()
    {
        if (sessionId is null || lifetime is null || runs?.Next is not { } next) return;
        await LoadRunsAsync(next);
    }
    private async Task LatestRunsAsync() { runCursor = null; await RefreshStateAsync(forceLatest: true); }
    private async Task LoadRunsAsync(ProjectRunCursor? cursor)
    {
        if (sessionId is null || lifetime is null) return;
        var response = await ApplicationChannel.SendAsync<GetProjectRunsRequest, GetProjectRunsResponse>(new(sessionId, cursor), lifetime.Token);
        if (response.Error is { } error) historyError = error;
        else if (response.Page is { } page) { runs = page; runCursor = cursor; historyError = null; }
    }
    private async Task LoadWorkbenchAsync()
    {
        if (sessionId is null || lifetime is null) return;
        var response = await ApplicationChannel.SendAsync<GetProjectWorkbenchRequest, GetProjectWorkbenchResponse>(new(sessionId), lifetime.Token);
        workbench = response.Projection; workbenchError = response.Error;
    }
    private async Task OpenDocumentAsync(ProjectWorkbenchEntry entry)
    {
        if (sessionId is null || lifetime is null) return;
        view = WorkbenchView.Document; document = null; documentError = null;
        var response = await ApplicationChannel.SendAsync<OpenProjectDocumentRequest, OpenProjectDocumentResponse>(new(sessionId, entry.Id), lifetime.Token);
        document = response.Document; documentError = response.Error;
    }
    private Task BackToExplorer() { view = WorkbenchView.Explorer; return Task.CompletedTask; }
    private async Task OpenTraceAsync(Guid runId)
    {
        if (sessionId is null || lifetime is null) return;
        view = WorkbenchView.RunTrace; selectedRun = null; traceEvents = null; traceError = null;
        var response = await ApplicationChannel.SendAsync<GetProjectRunRequest, GetProjectRunResponse>(new(sessionId, runId), lifetime.Token);
        if (response.Run is not { } detail) { traceError = response.Error; return; }
        selectedRun = detail;
        await LatestTraceAsync();
    }
    private async Task LatestTraceAsync()
    {
        if (selectedRun is null) return;
        traceThrough = selectedRun.Run.LastSequence;
        traceAfter = Math.Max(selectedRun.Run.AcceptedSequence - 1, traceThrough - 200);
        await LoadTraceAsync();
    }
    private async Task EarlierTraceAsync()
    {
        if (selectedRun is null || traceAfter <= selectedRun.Run.AcceptedSequence - 1) return;
        traceThrough = traceAfter; traceAfter = Math.Max(selectedRun.Run.AcceptedSequence - 1, traceThrough - 200); await LoadTraceAsync();
    }
    private async Task LaterTraceAsync()
    {
        if (selectedRun is null || traceEvents?.HasMore != true) return;
        traceAfter = traceThrough; traceThrough = Math.Min(selectedRun.Run.LastSequence, traceAfter + 200); await LoadTraceAsync();
    }
    private async Task LoadTraceAsync()
    {
        if (sessionId is null || lifetime is null || selectedRun is null) return;
        var response = await ApplicationChannel.SendAsync<GetProjectRunEventsRequest, GetProjectRunEventsResponse>(new(sessionId, selectedRun.Run.RunId, traceAfter, traceThrough), lifetime.Token);
        traceEvents = response.Page; traceError = response.Error;
    }
    private Task BackToMissions() { view = WorkbenchView.Missions; return Task.CompletedTask; }
    private async Task ConsumeEventsAsync(int ownerGeneration, CancellationToken ct)
    {
        try { await foreach (var evt in ApplicationChannel.Subscribe(ct)) if (ownerGeneration == generation && evt.SessionId == sessionId && evt.Kind == ApplicationEventKind.ProjectMissionChanged) await RefreshStateAsync(); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception exception) { if (ownerGeneration == generation) { connectionError = exception.Message; await InvokeAsync(StateHasChanged); } }
    }
    private async Task RestartSubscriptionAsync()
    {
        if (lifetime is null) return;
        connectionError = null;
        if (subscription is not null) await subscription;
        subscription = ConsumeEventsAsync(generation, lifetime.Token);
        await RefreshStateAsync();
    }
    private async Task StopLifetimeAsync()
    {
        if (lifetime is null) return;
        await lifetime.CancelAsync(); if (subscription is not null) await subscription; lifetime.Dispose(); lifetime = null; subscription = null;
    }
    private static bool Terminal(ConversationRunStatus status) => status is ConversationRunStatus.Completed or ConversationRunStatus.Failed or ConversationRunStatus.Interrupted or ConversationRunStatus.Rejected;
    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
    public async ValueTask DisposeAsync() => await StopLifetimeAsync();
}
