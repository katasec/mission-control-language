@page "/"
@inject IJSRuntime JavaScript
@inject MissionRuntimeSession MissionRuntime
@inject WorkspaceState WorkspaceState
@using ForgeMission.Core.Runtime

<section class="client-runtime-shell">
    <header class="client-runtime-header">
        <h1>Forge</h1>
        <p>Local Client Runtime</p>
    </header>

    <main class="client-runtime-main">
        @if (WorkspaceState.Root is { } root)
        {
            <p class="client-runtime-workspace">@root</p>
        }

        @if (_toolLog.Count > 0)
        {
            <section class="client-runtime-tool-calls" aria-label="Tool calls">
                <ul class="client-runtime-tool-call-list">
                    @foreach (var entry in _toolLog)
                    {
                        <li class="client-runtime-tool-call">
                            <span class="client-runtime-tool-call-glyph @(entry.IsRunning ? "client-runtime-tool-call-glyph--running" : "client-runtime-tool-call-glyph--done")"
                                  aria-hidden="true">@(entry.IsRunning ? string.Empty : "✓")</span>
                            <span>@entry.Text</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_response is not null)
        {
            <article class="client-runtime-response-card" aria-label="Response">
                <div class="client-runtime-response">@_response</div>
            </article>
        }

        <div class="client-runtime-composer">
            <div class="client-runtime-add-menu">
                <button class="client-runtime-add-button"
                        type="button"
                        aria-label="Add to workspace"
                        aria-haspopup="menu"
                        aria-expanded="@_isAddMenuOpen"
                        @onclick="ToggleAddMenu">
                    +
                </button>
                @if (_isAddMenuOpen)
                {
                    <div class="client-runtime-add-flyout" role="menu">
                        <button type="button" role="menuitem" @onclick="OpenFolderAsync">Add folder</button>
                    </div>
                }
            </div>
            <textarea id="prompt"
                      class="client-runtime-prompt"
                      @bind="_prompt"
                      @bind:event="oninput"
                      placeholder="@PromptPlaceholder"
                      aria-label="Prompt"
                      rows="1"></textarea>
            <button class="btn btn-accent client-runtime-send"
                    @onclick="SendPromptAsync"
                    disabled="@(_sending || WorkspaceState.Workspace is null)">
                @(_sending ? "Sending…" : "Send")
            </button>
        </div>

        @if (_status is not null)
        {
            <p class="client-runtime-status" role="status">@_status</p>
        }
    </main>
</section>

@code {
    private const int MaxToolTargetLength = 80;

    private readonly List<ToolLogEntry> _toolLog = [];
    private readonly Dictionary<string, ToolLogEntry> _toolLogByCallId = [];
    private string _prompt = string.Empty;
    private string? _response;
    private string? _status;
    private bool _isAddMenuOpen;
    private bool _sending;

    private string PromptPlaceholder => WorkspaceState.Workspace is null
        ? "Add a folder to start"
        : "Describe what you want to build";

    private void ToggleAddMenu() => _isAddMenuOpen = !_isAddMenuOpen;

    private async Task OpenFolderAsync()
    {
        _isAddMenuOpen = false;
        var path = await JavaScript.InvokeAsync<string?>("forgeDesktop.pickFolder");
        if (path is null)
        {
            _status = "No folder selected.";
            return;
        }

        WorkspaceState.OpenFolder(path);
        _status = null;
        Console.WriteLine($"Workspace: {WorkspaceState.Root}");
    }

    private async Task SendPromptAsync()
    {
        if (WorkspaceState.Workspace is not { } workspace || string.IsNullOrWhiteSpace(_prompt))
            return;

        _sending = true;
        _response = string.Empty;
        _toolLog.Clear();
        _toolLogByCallId.Clear();
        _status = null;

        try
        {
            await MissionRuntime.SendAsync(_prompt, workspace,
                onTextDelta: text => _ = InvokeAsync(() =>
                {
                    _response += text;
                    StateHasChanged();
                }),
                onToolCall: notification => _ = InvokeAsync(() =>
                {
                    UpdateToolLog(notification);
                    StateHasChanged();
                }));
        }
        catch (HttpRequestException exception)
        {
            _status = exception.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private void UpdateToolLog(ToolCallNotification notification)
    {
        var callId = notification.Call.CallId;
        if (!_toolLogByCallId.TryGetValue(callId, out var entry))
        {
            entry = new ToolLogEntry(callId);
            _toolLogByCallId[callId] = entry;
            _toolLog.Add(entry);
        }

        var formatted = FormatToolLog(notification);
        entry.Text = formatted.Text;
        entry.IsRunning = formatted.IsRunning;
    }

    private static FormattedToolLog FormatToolLog(ToolCallNotification notification)
    {
        var toolName = notification.Call.Name;
        var target = ToolTarget(notification.Call.Arguments, toolName);
        var isRunning = notification.State == ToolCallNotificationState.Running;
        var verb = isRunning ? RunningVerb(toolName) : DoneVerb(toolName);
        return new FormattedToolLog($"{verb} {target}{(isRunning ? "…" : string.Empty)}", isRunning);
    }

    private static string RunningVerb(string toolName) => toolName switch
    {
        "Read" => "Reading",
        "Edit" => "Editing",
        "Write" => "Writing",
        "Bash" => "Running",
        _ => "Using",
    };

    private static string DoneVerb(string toolName) => toolName switch
    {
        "Read" => "Read",
        "Edit" => "Edited",
        "Write" => "Wrote",
        "Bash" => "Ran",
        _ => "Used",
    };

    private static string ToolTarget(IDictionary<string, object?>? arguments, string toolName)
    {
        var key = toolName == "Bash" ? "command" : "file_path";
        var target = TryGetArgument(arguments, key) ?? toolName;
        return target.Length <= MaxToolTargetLength
            ? target
            : target[..(MaxToolTargetLength - 1)] + "…";
    }

    private static string? TryGetArgument(IDictionary<string, object?>? arguments, string key)
    {
        if (arguments is null || !arguments.TryGetValue(key, out var value))
            return null;

        return value switch
        {
            string text when !string.IsNullOrWhiteSpace(text) => text,
            not null => value.ToString(),
            _ => null,
        };
    }

    private sealed class ToolLogEntry(string callId)
    {
        public string CallId { get; } = callId;
        public bool IsRunning { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private sealed record FormattedToolLog(string Text, bool IsRunning);
}
