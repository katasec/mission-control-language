<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- This Host reaches Core's YAML entry points through Application (the Project lock file),
         so YamlDotNet's reflection-based builders land in its AOT closure the same way they land
         in the CLI's. Core already preserves every POCO that crosses those builders with
         [DynamicDependency], so the assembly-level warnings are the conservative roll-up rather
         than a real trim hazard. Same handling, same reason, as ForgeMission.Cli. -->
    <IlcSuppressWarnings>IL3050</IlcSuppressWarnings>
    <NoWarn>$(NoWarn);IL3050;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeMission.Application\ForgeMission.Application.csproj" />
    <ProjectReference Include="..\ForgeMission.Application.Transport\ForgeMission.Application.Transport.csproj" />
    <ProjectReference Include="..\ForgeMission.ClientRuntime\ForgeMission.ClientRuntime.csproj" />
    <ProjectReference Include="..\ForgeMission.Presentation\ForgeMission.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.0" />
  </ItemGroup>

  <!-- Native AOT on macOS: system libs needed by the AOT runtime live under Homebrew -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <LinkerArg Include="-L/opt/homebrew/lib" />
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" />
  </ItemGroup>

  <!-- The Presentation project reference exists to pull in its wwwroot static assets (served
       from _framework/*.wasm) — its own .runtimeconfig.json is a vestigial publish byproduct
       with no runtime purpose (there's no matching .dll at the top level; Presentation's actual
       compiled code lives entirely under wwwroot/_framework). -->
  <Target Name="RemoveVestigialPresentationRuntimeConfig" AfterTargets="Publish">
    <ItemGroup>
      <_VestigialPresentationFiles Include="$(PublishDir)ForgeMission.Presentation.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(_VestigialPresentationFiles)" Condition="Exists('%(_VestigialPresentationFiles.Identity)')" />
  </Target>
</Project>
