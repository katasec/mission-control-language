681:     private void AppendLayoutLine(int start, int length, bool isFirstLine, bool isLastInHardLine, int width)
682:     {
683:         EnsureLayoutLineCapacity(_layoutLineCount + 1);
684: 
685:         var text = Text ?? string.Empty;
686:         var clampedStart = Math.Clamp(start, 0, text.Length);
687:         var clampedLength = Math.Max(0, Math.Min(length, text.Length - clampedStart));
688: 
689:         var indent = GetIndent(isFirstLine);
690:         var prefixWidth = GetPrefixWidth(isFirstLine);
691:         var availableTextWidth = Math.Max(0, width - indent - prefixWidth);
692:         if (availableTextWidth <= 0)
693:         {
694:             clampedLength = 0;
695:         }
696: 
697:         var textWidth = clampedLength == 0
698:             ? 0
699:             : TerminalTextUtility.GetWidth(text.AsSpan(clampedStart, clampedLength));
700: 
701:         _layoutLines[_layoutLineCount++] = new LayoutLine(
702:             Start: clampedStart,
703:             Length: clampedLength,
704:             TextWidth: textWidth,
705:             Indent: indent,
706:             PrefixWidth: prefixWidth,
707:             IsFirstLine: isFirstLine,
708:             IsLastInHardLine: isLastInHardLine);
