753:     private static bool TryGetNextWrapSlice(ReadOnlySpan<char> text, int start, int width, out int endExclusive, out int nextStart)
754:     {
755:         endExclusive = start;
756:         nextStart = start;
757: 
758:         if (start >= text.Length)
759:         {
760:             return false;
761:         }
762: 
763:         while (start < text.Length && char.IsWhiteSpace(text[start]))
764:         {
765:             start++;
766:         }
767: 
768:         if (start >= text.Length)
769:         {
770:             return false;
771:         }
772: 
773:         if (!TerminalTextUtility.TryGetIndexAtCell(text[start..], width, out var relativeEnd))
774:         {
775:             relativeEnd = text.Length - start;
776:         }
777: 
778:         var tentativeEnd = Math.Clamp(start + relativeEnd, start, text.Length);
779:         var wrapEnd = tentativeEnd;
780:         if (tentativeEnd < text.Length)
781:         {
782:             var lastSpace = -1;
783:             for (var index = tentativeEnd - 1; index > start; index--)
784:             {
785:                 if (char.IsWhiteSpace(text[index]))
786:                 {
787:                     lastSpace = index;
788:                     break;
789:                 }
790:             }
791: 
792:             if (lastSpace > start)
793:             {
794:                 wrapEnd = lastSpace;
795:             }
796:         }
797: 
798:         endExclusive = wrapEnd;
799:         nextStart = wrapEnd;
800:         while (nextStart < text.Length && char.IsWhiteSpace(text[nextStart]))
801:         {
802:             nextStart++;
803:         }
804: 
805:         return endExclusive > start;
