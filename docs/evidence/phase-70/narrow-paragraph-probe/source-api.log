366:     private void WriteStyledSpan(
367:         CellBuffer buffer,
368:         int x,
369:         int y,
370:         ReadOnlySpan<char> text,
371:         int start,
372:         int endExclusive,
373:         bool hasSelection,
374:         int selectionStart,
375:         int selectionEnd,
376:         Style selectionStyle)
377:     {
378:         if (start >= endExclusive)
379:         {
380:             return;
381:         }
382: 
383:         var runs = _normalizedRuns;
384:         var hyperlinks = _normalizedHyperlinks;
385: 
386:         if (runs.Length == 0 && hyperlinks.Length == 0 && !hasSelection)
387:         {
388:             buffer.WriteText(x, y, text.Slice(start, endExclusive - start), Style.None);
389:             return;
390:         }
391: 
392:         var runIndex = FindFirstPotentialRun(runs, start);
393:         var hyperlinkIndex = FindFirstPotentialHyperlink(hyperlinks, start);
394:         var position = start;
395:         var posX = x;
396: 
397:         while (position < endExclusive && posX < buffer.Width)
398:         {
399:             var nextBoundary = endExclusive;
400: 
401:             var runStyle = Style.None;
402:             if (TryGetRunAt(runs, ref runIndex, position, out var currentRun))
403:             {
404:                 runStyle = currentRun.Style;
405:                 nextBoundary = Math.Min(nextBoundary, currentRun.Start + currentRun.Length);
406:             }
407:             else if ((uint)runIndex < (uint)runs.Length)
408:             {
409:                 nextBoundary = Math.Min(nextBoundary, runs[runIndex].Start);
410:             }
411: 
412:             ulong hyperlinkToken = 0;
413:             if (TryGetHyperlinkAt(hyperlinks, ref hyperlinkIndex, position, out var currentHyperlink))
414:             {
415:                 hyperlinkToken = GetHyperlinkToken(buffer, currentHyperlink.Uri);
416:                 nextBoundary = Math.Min(nextBoundary, currentHyperlink.Start + currentHyperlink.Length);
417:             }
418:             else if ((uint)hyperlinkIndex < (uint)hyperlinks.Length)
419:             {
420:                 nextBoundary = Math.Min(nextBoundary, hyperlinks[hyperlinkIndex].Start);
421:             }
422: 
423:             if (hasSelection)
424:             {
425:                 if (position < selectionStart)
426:                 {
427:                     nextBoundary = Math.Min(nextBoundary, selectionStart);
428:                 }
429:                 else if (position < selectionEnd)
430:                 {
431:                     nextBoundary = Math.Min(nextBoundary, selectionEnd);
432:                 }
433:             }
434: 
435:             if (nextBoundary <= position)
436:             {
437:                 nextBoundary = Math.Min(endExclusive, position + 1);
438:             }
439: 
440:             var segment = text.Slice(position, nextBoundary - position);
441:             var effectiveStyle = runStyle;
442:             if (hasSelection && position >= selectionStart && position < selectionEnd)
443:             {
444:                 effectiveStyle |= selectionStyle;
445:             }
446: 
447:             buffer.WriteText(posX, y, segment, effectiveStyle, hyperlinkToken);
448:             posX += GetRenderedCellWidth(segment, posX);
449:             position = nextBoundary;
