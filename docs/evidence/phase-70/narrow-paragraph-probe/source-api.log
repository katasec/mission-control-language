353:     public void WriteText(int x, int y, ReadOnlySpan<char> text, Style style, ulong hyperlinkToken)
354:     {
355:         var posX = x;
356:         var index = 0;
357:         while (index < text.Length && posX < Width)
358:         {
359:             var elementLength = StringInfo.GetNextTextElementLength(text[index..]);
360:             if (elementLength <= 0)
361:             {
362:                 elementLength = 1;
363:             }
364: 
365:             var elementSpan = text.Slice(index, Math.Min(elementLength, text.Length - index));
366:             if (elementSpan.Length == 1 && elementSpan[0] == '\t')
367:             {
368:                 // Expand tab using a deterministic tab stop so that cell-buffer rendering remains consistent.
369:                 var tabWidth = global::XenoAtom.Terminal.TerminalTextUtility.DefaultTabWidth;
370:                 var spaces = tabWidth - (posX % tabWidth);
371:                 spaces = Math.Max(1, spaces);
372:                 for (var s = 0; s < spaces && posX < Width; s++)
373:                 {
374:                     SetCell(posX++, y, new Rune(' '), style, hyperlinkToken);
375:                 }
376: 
377:                 index += elementLength;
378:                 continue;
379:             }
380: 
381:             var w = GetTextElementWidth(elementSpan);
382:             if (w > 0)
383:             {
384:                 if (posX + w > Width)
385:                 {
386:                     break;
387:                 }
388: 
389:                 if (TryDecodeSingleRune(elementSpan, out var rune))
390:                 {
391:                     SetCell(posX, y, rune, style, hyperlinkToken);
392:                 }
393:                 else
394:                 {
395:                     var token = RegisterTextElement(elementSpan, w);
396:                     SetTextElementToken(posX, y, token, w, style, hyperlinkToken);
397:                 }
398:                 posX += w;
399:             }
400: 
401:             index += elementLength;
402:         }
403:     }
