# syntax=docker/dockerfile:1
# ForgeMission.Api ("ForgeAPI") — the tier-1 API gateway for the hosted /v1 + API-A endpoints (42.6).
#
# NOT Native AOT here: PublishAot is flipped on as a fast-follow once the endpoint works end-to-end
# (see ForgeMission.Api.csproj's own comment) — this build stays a normal JIT ASP.NET host, same
# shape as Dockerfile.forgeui. Build context = repo root.
#
# ForgeAPI restores private GitHub Packages, including Runner Contracts and Billing. Supply the
# read:packages token only as a BuildKit secret; it must never become an ARG, ENV, image layer, or
# runtime secret.
#
#   NUGET_AUTH_TOKEN=<gh read:packages PAT> \
#   docker buildx build --secret id=nuget_token,env=NUGET_AUTH_TOKEN \
#     -f Dockerfile.forgeapi -t forge-api:local .

# ---- build --------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY nuget.config ./
COPY src/ ./src/

RUN --mount=type=secret,id=nuget_token \
    NUGET_AUTH_TOKEN="$(cat /run/secrets/nuget_token)" \
    dotnet publish src/ForgeMission.Api/ForgeMission.Api.csproj -c Release -o /app/publish \
      /p:UseAppHost=false /p:PublishAot=false

# ---- runtime ------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish ./

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_gcServer=0

EXPOSE 8080
ENTRYPOINT ["dotnet", "ForgeMission.Api.dll"]
